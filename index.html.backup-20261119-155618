                poNumber: sample.poNumber || '-',
                location: sample.location || sample.site || '-',
                poStart: sample.poStart || '-',
                poEnd: sample.poEnd || '-',
                towerCount: towers.length,
                totalInvoiced: 0, // Could calculate from invoice history
                archivedAt: new Date().toISOString(),
                archivedBy: currentUser.name
            };
            
            archivedPOs.push(archived);
            localStorage.setItem('mlt_archived_pos', JSON.stringify(archivedPOs));
            
            addAuditEntry('ARCHIVE_PO', `${jobCode} (${sample.customer}) - ${towers.length} towers`);
