        // PO Management Functions
        function renderPOManagement() {
            const today = new Date();
            const alertsContainer = document.getElementById('poExpiryAlerts');
            const tableBody = document.getElementById('poManagementTable');
            
            // Get all unique jobs with PO info from fleet data
            const jobsMap = new Map();
            fleetData.forEach(t => {
                if (t.visionJob && t.poEnd) {
                    const key = t.visionJob;
                    if (!jobsMap.has(key)) {
                        jobsMap.set(key, {
                            customer: t.customer || 'Unknown',
                            jobCode: t.visionJob,
                            poNumber: t.poNumber || '-',
                            location: t.location || t.site || '-',
                            poStart: t.poStart || '-',
                            poEnd: t.poEnd,
                            invoicingSchedule: t.invoicingSchedule || '-',
                            towers: []
                        });
                    }
                    jobsMap.get(key).towers.push(t);
                }
            });
            
            const jobs = Array.from(jobsMap.values());
            
            // Sort by end date (soonest first)
            jobs.sort((a, b) => new Date(a.poEnd) - new Date(b.poEnd));
            
            // Build alerts for expiring/expired POs
            let alertsHtml = '';
            jobs.forEach(job => {
                const endDate = new Date(job.poEnd);
                const daysLeft = Math.ceil((endDate - today) / (1000 * 60 * 60 * 24));
                
                if (daysLeft <= 30) {
                    const isExpired = daysLeft < 0;
                    alertsHtml += `
                        <div class="po-alert-card ${isExpired ? 'expired' : 'expiring-soon'}">
                            <div class="po-alert-customer">${job.customer}</div>
                            <div class="po-alert-job">${job.jobCode} - ${job.location}</div>
                            <div class="po-alert-info">PO: ${job.poNumber} | ${job.towers.length} towers</div>
                            <span class="po-alert-badge ${isExpired ? 'expired' : 'warning'}">
                                ${isExpired ? 'EXPIRED ' + Math.abs(daysLeft) + ' days ago' : daysLeft + ' days left'}
                            </span>
                            <button class="btn small" style="margin-left:12px" onclick="archivePO('${job.jobCode}')">Archive</button>
                        </div>
                    `;
                }
            });
            
            alertsContainer.innerHTML = alertsHtml || '<p style="color:var(--text-secondary)">No POs expiring within 30 days</p>';
            
            // Build table
            let tableHtml = '';
            jobs.forEach(job => {
                const endDate = new Date(job.poEnd);
                const daysLeft = Math.ceil((endDate - today) / (1000 * 60 * 60 * 24));
                const daysClass = daysLeft < 0 ? 'color:var(--danger)' : daysLeft <= 14 ? 'color:var(--warning)' : '';
                
                tableHtml += `
                    <tr>
                        <td>${job.customer}</td>
                        <td>${job.jobCode}</td>
                        <td>${job.poNumber}</td>
                        <td>${job.location}</td>
                        <td>${job.poStart}</td>
                        <td>${job.poEnd}</td>
                        <td style="${daysClass};font-weight:600">${daysLeft < 0 ? 'Expired' : daysLeft + ' days'}</td>
                        <td>${job.towers.length}</td>
                        <td>${job.invoicingSchedule}</td>
                        <td>
                            <button class="btn small" onclick="archivePO('${job.jobCode}')">Archive</button>
                        </td>
                    </tr>
                `;
            });
            
            tableBody.innerHTML = tableHtml || '<tr><td colspan="10" style="text-align:center;color:var(--text-secondary)">No active POs with end dates</td></tr>';
        }
        
        // Revenue Functions
        function renderRevenue() {
            const onHire = fleetData.filter(t => (t.status || '').toUpperCase().includes('ON HIRE'));
            
            let totalWeekly = 0;
            let totalMonthly = 0;
            let dailyRates = [];
            
            // Group by customer
            const customerRevenue = {};
            
            onHire.forEach(t => {
                const customer = t.customer || 'Unknown';
                const daily = parseFloat(t.rateDaily) || 0;
                const monthly = parseFloat(t.rateMonthly) || 0;
                const schedule = (t.invoicingSchedule || '').toUpperCase();
                
                if (!customerRevenue[customer]) {
                    customerRevenue[customer] = {
                        towers: 0,
                        weeklyCount: 0,
                        monthlyCount: 0,
                        weeklyRevenue: 0,
                        monthlyRevenue: 0
                    };
                }
                
                customerRevenue[customer].towers++;
                
                if (schedule === 'WEEKLY') {
                    customerRevenue[customer].weeklyCount++;
                    customerRevenue[customer].weeklyRevenue += daily * 7;
                    totalWeekly += daily * 7;
                } else if (schedule === 'MONTHLY') {
                    customerRevenue[customer].monthlyCount++;
                    customerRevenue[customer].monthlyRevenue += monthly;
                    totalMonthly += monthly;
                } else {
                    // Default calculation
                    if (daily > 0) {
                        customerRevenue[customer].weeklyRevenue += daily * 7;
                        totalWeekly += daily * 7;
                    }
                }
                
                if (daily > 0) dailyRates.push(daily);
            });
            
            // Update summary cards
            document.getElementById('weeklyRevenue').textContent = '$' + totalWeekly.toLocaleString('en-AU', {minimumFractionDigits: 0, maximumFractionDigits: 0});
            document.getElementById('monthlyRevenue').textContent = '$' + totalMonthly.toLocaleString('en-AU', {minimumFractionDigits: 0, maximumFractionDigits: 0});
            document.getElementById('activeTowers').textContent = onHire.length;
            
            const avgRate = dailyRates.length > 0 ? dailyRates.reduce((a,b) => a+b, 0) / dailyRates.length : 0;
            document.getElementById('avgDailyRate').textContent = '$' + avgRate.toFixed(2);
            
            // Build revenue table
            let tableHtml = '';
            Object.keys(customerRevenue).sort().forEach(customer => {
                const c = customerRevenue[customer];
                tableHtml += `
                    <tr>
                        <td>${customer}</td>
                        <td>${c.towers}</td>
                        <td>${c.weeklyCount}</td>
                        <td>${c.monthlyCount}</td>
                        <td class="money">$${c.weeklyRevenue.toLocaleString('en-AU', {minimumFractionDigits: 0})}</td>
                        <td class="money">$${c.monthlyRevenue.toLocaleString('en-AU', {minimumFractionDigits: 0})}</td>
                    </tr>
                `;
            });
            
            document.getElementById('revenueTable').innerHTML = tableHtml || '<tr><td colspan="6" style="text-align:center">No revenue data</td></tr>';
        }
        
