<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MLT Asset Tracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --bg-primary: #0a0a0a;
            --bg-secondary: #111111;
            --bg-tertiary: #1a1a1a;
            --bg-hover: #222222;
            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --text-muted: #666666;
            --accent: #f97316;
            --accent-hover: #ea580c;
            --success: #22c55e;
            --warning: #eab308;
            --danger: #ef4444;
            --border: #2a2a2a;
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
        }
        
        /* Login Screen */
        .login-screen {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .login-box {
            background: var(--bg-secondary);
            padding: 48px;
            border-radius: 16px;
            border: 1px solid var(--border);
            width: 100%;
            max-width: 400px;
            text-align: center;
        }
        
        .login-logo {
            width: 80px;
            height: 80px;
            background: var(--accent);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            margin: 0 auto 24px;
        }
        
        .login-title { font-size: 24px; margin-bottom: 8px; font-weight: 600; }
        .login-subtitle { color: var(--text-secondary); margin-bottom: 32px; }
        
        .login-input {
            width: 100%;
            padding: 14px 16px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 16px;
            text-align: center;
            letter-spacing: 1px;
            margin-bottom: 16px;
        }
        
        .login-input:focus { outline: none; border-color: var(--accent); }
        .login-input::placeholder { letter-spacing: normal; }
        
        .login-btn {
            width: 100%;
            padding: 14px;
            background: var(--accent);
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }
        
        .login-btn:hover { background: var(--accent-hover); }
        .login-error { color: var(--danger); margin-top: 16px; display: none; }
        .login-security { margin-top: 24px; font-size: 12px; color: var(--text-muted); }
        
        .hidden { display: none !important; }
        
        /* Main Layout */
        .app-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        /* Top Bar */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 24px;
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border);
            gap: 20px;
        }
        
        .topbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .logo {
            width: 40px;
            height: 40px;
            background: var(--accent);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
        }
        
        .logo-text { font-size: 18px; font-weight: 700; }
        .logo-sub { font-size: 11px; color: var(--text-secondary); }
        
        /* Nav Tabs */
        .nav-tabs {
            display: flex;
            gap: 8px;
        }
        
        .nav-tab {
            padding: 10px 20px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }
        
        .nav-tab:hover { background: var(--bg-tertiary); color: var(--text-primary); }
        .nav-tab.active { background: var(--accent); border-color: var(--accent); color: white; }
        
        /* User */
        .topbar-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .user-name { font-weight: 600; font-size: 14px; }
        .user-role { font-size: 11px; color: var(--text-secondary); text-transform: uppercase; }
        
        .user-avatar {
            width: 36px;
            height: 36px;
            background: var(--accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }
        
        .logout-btn {
            padding: 8px 14px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-secondary);
            font-size: 13px;
            cursor: pointer;
        }
        
        .logout-btn:hover { background: var(--bg-tertiary); color: var(--text-primary); }
        
        /* Main Wrapper */
        .main-wrapper {
            display: flex;
            flex: 1;
            overflow: hidden;
        }
        
        .view { display: none; flex: 1; overflow: hidden; }
        .view.active { display: flex; }
        
        /* Column Panel */
        .column-panel {
            width: 240px;
            min-width: 200px;
            background: var(--bg-secondary);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        .column-panel.wide { width: 300px; }
        
        .column-header {
            padding: 16px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .column-title {
            font-size: 11px;
            font-weight: 600;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .column-content {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
        }
        
        .column-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.15s;
            margin-bottom: 4px;
        }
        
        .column-item:hover { background: var(--bg-tertiary); }
        .column-item.active { background: var(--bg-tertiary); border-left: 3px solid var(--accent); }
        
        .column-item-name { font-size: 14px; font-weight: 500; }
        .column-item-sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
        .column-item-count {
            font-size: 12px;
            color: var(--text-muted);
            background: var(--bg-primary);
            padding: 2px 8px;
            border-radius: 4px;
        }
        .column-item-count.money { color: var(--success); background: rgba(34,197,94,0.1); }
        
        .add-btn {
            width: 100%;
            padding: 10px;
            background: transparent;
            border: 1px dashed var(--border);
            border-radius: 8px;
            color: var(--text-muted);
            font-size: 13px;
            cursor: pointer;
            margin-top: 8px;
            transition: all 0.15s;
        }
        
        .add-btn:hover { border-color: var(--accent); color: var(--accent); }
        
        /* Finance Header & Tabs */
        .finance-header {
            display: none; /* Hide when not needed */
        }
        
        .finance-subtabs {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            background: var(--bg-tertiary);
            border-bottom: 1px solid var(--border);
        }
        
        .finance-subtabs .finance-tabs {
            display: flex;
            gap: 8px;
        }
        
        .finance-subtabs .finance-filters {
            display: flex;
            gap: 12px;
            margin-left: auto;
        }
        
        .finance-tab {
            padding: 10px 16px;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 8px;
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s;
        }
        
        .finance-tab:hover { background: var(--bg-tertiary); color: var(--text-primary); }
        .finance-tab.active { background: var(--accent); color: white; border-color: var(--accent); }
        
        .finance-filters {
            display: flex;
            gap: 12px;
        }
        
        .finance-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        .finance-content.hidden { display: none; }
        
        .finance-columns {
            display: flex;
            flex: 1;
            overflow: hidden;
        }
        
        /* Revenue Tab */
        .revenue-container {
            padding: 24px;
            overflow-y: auto;
        }
        
        .revenue-summary {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }
        
        .revenue-card {
            background: var(--bg-secondary);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }
        
        .revenue-label {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        
        .revenue-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--success);
        }
        
        /* PO Management Tab */
        .po-management-container {
            padding: 24px;
            overflow-y: auto;
        }
        
        .po-alerts-section {
            margin-bottom: 32px;
        }
        
        .po-alerts-section h3 {
            margin-bottom: 16px;
            font-size: 16px;
        }
        
        .po-alert-cards {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
        }
        
        .po-alert-card {
            background: var(--bg-secondary);
            padding: 16px;
            border-radius: 12px;
            border-left: 4px solid var(--warning);
        }
        
        .po-alert-card.expired { border-left-color: var(--danger); }
        .po-alert-card.expiring-soon { border-left-color: var(--warning); }
        
        .po-alert-customer {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 4px;
        }
        
        .po-alert-job {
            color: var(--accent);
            font-size: 13px;
            margin-bottom: 8px;
        }
        
        .po-alert-info {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 12px;
        }
        
        .po-alert-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
        }
        
        .po-alert-badge.expired { background: rgba(239, 68, 68, 0.2); color: var(--danger); }
        .po-alert-badge.warning { background: rgba(234, 179, 8, 0.2); color: var(--warning); }
        
        .po-table-section h3 {
            margin-bottom: 16px;
            font-size: 16px;
        }
        
        /* Archive Tab */
        .archive-container {
            padding: 24px;
            overflow-y: auto;
        }
        
        .archive-header {
            margin-bottom: 24px;
        }
        
        .archive-header h3 {
            font-size: 18px;
            margin-bottom: 4px;
        }
        
        /* Invoice Panel */
        .invoice-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--bg-primary);
        }
        
        .invoice-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-secondary);
        }
        
        .invoice-title { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
        .invoice-subtitle { color: var(--text-secondary); font-size: 14px; }
        .invoice-po { color: var(--accent); font-size: 13px; margin-top: 4px; }
        
        .invoice-actions {
            display: flex;
            gap: 8px;
            margin-top: 16px;
            flex-wrap: wrap;
        }
        
        .btn {
            padding: 10px 16px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.15s;
        }
        
        .btn:hover { background: var(--bg-hover); }
        .btn.primary { background: var(--accent); border-color: var(--accent); }
        .btn.primary:hover { background: var(--accent-hover); }
        .btn.success { background: var(--success); border-color: var(--success); }
        .btn.small { padding: 6px 12px; font-size: 12px; }
        
        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th { text-align: left; padding: 12px; font-size: 11px; text-transform: uppercase; color: var(--text-muted); border-bottom: 1px solid var(--border); }
        .data-table td { padding: 12px; border-bottom: 1px solid var(--border); font-size: 13px; }
        .data-table td.money { text-align: right; color: var(--success); font-weight: 600; }
        .data-table th.money { text-align: right; }
        .data-table tr:hover { background: var(--bg-tertiary); }
        
        .invoice-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            padding: 20px 24px;
            border-bottom: 1px solid var(--border);
        }
        
        .invoice-stat {
            background: var(--bg-secondary);
            padding: 16px;
            border-radius: 8px;
        }
        
        .invoice-stat-label {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        
        .invoice-stat-value { font-size: 24px; font-weight: 700; }
        .invoice-stat-value.money { color: var(--success); }
        
        .invoice-table-wrap {
            flex: 1;
            overflow: auto;
            padding: 16px 24px;
        }
        
        .data-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .data-table th {
            text-align: left;
            padding: 12px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            border-bottom: 2px solid var(--border);
            position: sticky;
            top: 0;
            background: var(--bg-primary);
        }
        
        .data-table td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            font-size: 14px;
        }
        
        .data-table tr:hover { background: var(--bg-tertiary); }
        
        .data-table .tower-id { color: var(--accent); font-weight: 600; }
        .data-table .money { text-align: right; }
        .data-table .total-row { font-weight: 700; background: var(--bg-secondary); }
        .data-table .total-row td { border-top: 2px solid var(--border); }
        
        .config-badge {
            display: inline-block;
            padding: 3px 8px;
            background: var(--bg-tertiary);
            border-radius: 4px;
            font-size: 11px;
            color: var(--text-secondary);
        }
        
        /* Operations View */
        .ops-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        .ops-header {
            padding: 16px 24px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-secondary);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }
        
        .ops-title { font-size: 16px; font-weight: 600; }
        
        .ops-tabs {
            display: flex;
            gap: 8px;
            padding: 0 24px 16px;
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border);
        }
        
        .ops-tab {
            padding: 8px 16px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-secondary);
            font-size: 13px;
            cursor: pointer;
        }
        
        .ops-tab:hover { background: var(--bg-tertiary); }
        .ops-tab.active { background: var(--accent); border-color: var(--accent); color: white; }
        
        .ops-content {
            flex: 1;
            overflow: auto;
            padding: 24px;
        }
        
        .ops-section {
            background: var(--bg-secondary);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .ops-section-title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }
        
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        
        .form-label {
            font-size: 12px;
            color: var(--text-secondary);
            font-weight: 500;
        }
        
        .form-input, .form-select {
            padding: 10px 12px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-primary);
            font-size: 14px;
        }
        
        .form-input:focus, .form-select:focus {
            outline: none;
            border-color: var(--accent);
        }
        
        /* Audit Log */
        .audit-log {
            max-height: 300px;
            overflow-y: auto;
        }
        
        .audit-item {
            padding: 12px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
        }
        
        .audit-item:last-child { border-bottom: none; }
        
        .audit-time { color: var(--text-muted); font-size: 11px; }
        .audit-user { color: var(--accent); font-weight: 500; }
        .audit-action { color: var(--text-secondary); }
        .audit-detail { color: var(--text-primary); margin-top: 4px; }
        
        /* Admin View */
        
        /* PO Alerts Styles */
        .po-alerts-container {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
            background: var(--bg-primary);
        }
        .po-alerts-header { margin-bottom: 24px; }
        .po-alerts-header h2 { font-size: 24px; margin: 0 0 8px 0; }
        .po-alerts-header p { color: var(--text-muted); margin: 0; }
        .po-stats-row {
            display: flex;
            gap: 16px;
            margin-bottom: 24px;
        }
        .po-stat {
            flex: 1;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
        }
        .po-stat.critical { border-left: 4px solid #ef4444; }
        .po-stat.warning { border-left: 4px solid #f59e0b; }
        .po-stat.caution { border-left: 4px solid #eab308; }
        .po-stat.ok { border-left: 4px solid #22c55e; }
        .po-stat-value { font-size: 32px; font-weight: 700; }
        .po-stat.critical .po-stat-value { color: #ef4444; }
        .po-stat.warning .po-stat-value { color: #f59e0b; }
        .po-stat.caution .po-stat-value { color: #eab308; }
        .po-stat.ok .po-stat-value { color: #22c55e; }
        .po-stat-label { font-size: 12px; color: var(--text-muted); text-transform: uppercase; margin-top: 4px; }
        .po-filter-row {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
        }
        .po-filter-btn {
            padding: 8px 16px;
            border: 1px solid var(--border);
            background: var(--bg-secondary);
            color: var(--text-primary);
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
        }
        .po-filter-btn:hover { background: var(--bg-tertiary); }
        .po-filter-btn.active { background: var(--accent); border-color: var(--accent); }
        .po-alerts-table-container {
            background: var(--bg-secondary);
            border-radius: 8px;
            border: 1px solid var(--border);
            overflow: hidden;
        }
        .po-alerts-table {
            width: 100%;
            border-collapse: collapse;
        }
        .po-alerts-table th {
            text-align: left;
            padding: 12px 16px;
            font-size: 11px;
            text-transform: uppercase;
            color: var(--text-muted);
            background: var(--bg-tertiary);
            border-bottom: 1px solid var(--border);
        }
        .po-alerts-table td {
            padding: 12px 16px;
            font-size: 13px;
            border-bottom: 1px solid var(--border);
        }
        .po-alerts-table tr:hover { background: var(--bg-tertiary); }
        .po-status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .po-status-badge.expired { background: rgba(239,68,68,0.2); color: #ef4444; }
        .po-status-badge.critical { background: rgba(245,158,11,0.2); color: #f59e0b; }
        .po-status-badge.warning { background: rgba(234,179,8,0.2); color: #eab308; }
        .po-status-badge.ok { background: rgba(34,197,94,0.2); color: #22c55e; }
        
        .admin-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            padding: 24px;
        }
        
        .admin-card {
            background: var(--bg-secondary);
            border-radius: 12px;
            padding: 20px;
        }
        
        .admin-card-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .admin-list {
            max-height: 250px;
            overflow-y: auto;
            margin-bottom: 16px;
        }
        
        .admin-list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 12px;
            background: var(--bg-tertiary);
            border-radius: 6px;
            margin-bottom: 6px;
            font-size: 13px;
        }
        
        .admin-list-item .delete-btn {
            padding: 4px 8px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 4px;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 11px;
        }
        
        .admin-list-item .delete-btn:hover {
            background: var(--danger);
            border-color: var(--danger);
            color: white;
        }
        
        /* Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
        }
        
        .modal {
            background: var(--bg-secondary);
            border-radius: 12px;
            width: 100%;
            max-width: 500px;
            max-height: 90vh;
            overflow-y: auto;
        }
        
        .modal-header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .modal-title { font-size: 18px; font-weight: 600; }
        
        .modal-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 24px;
            cursor: pointer;
            line-height: 1;
        }
        
        .modal-close:hover { color: var(--text-primary); }
        
        .modal-body { padding: 20px; }
        
        .modal-footer {
            padding: 16px 20px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }
        
        /* Empty State */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            color: var(--text-muted);
            text-align: center;
        }
        
        .empty-state-icon { font-size: 48px; margin-bottom: 16px; }
        .empty-state-text { font-size: 14px; }
        
        /* Toast */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--success);
            color: white;
            padding: 16px 24px;
            border-radius: 8px;
            font-weight: 500;
            display: none;
            z-index: 1001;
            animation: slideIn 0.3s ease;
        }
        
        .toast.error { background: var(--danger); }
        .toast.active { display: block; }
        
        @keyframes slideIn {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        
        /* Dashboard Styles */
        .dashboard-container {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
            background: var(--bg-primary);
        }
        
        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
