        .presence-user-avatar .status-dot.online {
            background: #22c55e;
        }
        
        .presence-user-avatar .status-dot.offline {
            background: #6b7280;
        }
        
        .presence-user-avatar .status-dot.away {
            background: #eab308;
        }
        
        .presence-user-info {
            flex: 1;
            min-width: 0;
        }
        
        .presence-user-name {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .presence-user-status {
            font-size: 11px;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 4px;
        }
        
        .presence-user-status.online {
            color: #22c55e;
        }
        
        .presence-user-activity {
            font-size: 10px;
            color: var(--text-secondary);
            font-style: italic;
        }
        
        .presence-section-label {
            font-size: 10px;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 8px 16px 4px;
            margin-top: 4px;
        }
        
        .presence-empty {
            padding: 40px 20px;
            text-align: center;
            color: rgba(255, 255, 255, 0.4);
            font-size: 13px;
        }
        
        .presence-empty::before {
            content: '👤';
            display: block;
            font-size: 32px;
            margin-bottom: 12px;
            opacity: 0.5;
        }
        
        /* Premium Footer */
        .presence-connection-status {
            padding: 12px 20px;
            background: rgba(0, 0, 0, 0.2);
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.5);
        }
        
        .presence-connection-status .connection-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #6b7280;
            transition: all 0.3s ease;
        }
        
        .presence-connection-status .connection-dot.connected {
            background: #22c55e;
            box-shadow: 0 0 6px rgba(34, 197, 94, 0.4);
        }
        
        .presence-connection-status .connection-text {
            font-weight: 500;
        }
        
        /* ============================================
           PREMIUM USER CARDS - Slack/Linear Style
           ============================================ */
        
        .presence-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            margin: 2px 8px;
            border-radius: 8px;
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: default;
        }
        
        .presence-item:hover {
            background: rgba(255, 255, 255, 0.04);
        }
        
        .presence-item.presence-current {
            background: rgba(34, 197, 94, 0.08);
            border: 1px solid rgba(34, 197, 94, 0.15);
        }
        
        .presence-item.presence-current:hover {
            background: rgba(34, 197, 94, 0.12);
        }
        
        /* Premium Avatar */
        .presence-avatar {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 600;
            color: white;
            position: relative;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            transition: transform 0.15s ease;
        }
        
        .presence-item:hover .presence-avatar {
            transform: scale(1.05);
        }
        
        /* Status indicator on avatar */
        .presence-avatar::after {
            content: '';
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #22c55e;
            border: 2px solid #18181b;
            box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.2);
        }
        
        /* User Info Section */
        .presence-info {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        
        .presence-name {
            font-size: 13px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.95);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            letter-spacing: -0.01em;
        }
        
        .presence-view {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.45);
            display: flex;
            align-items: center;
            gap: 4px;
        }
        
        .presence-view::before {
            content: '•';
            color: rgba(255, 255, 255, 0.25);
        }
        
        /* Role Badge */
        .presence-role-badge {
            font-size: 9px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 2px 6px;
            border-radius: 4px;
            background: rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.6);
        }
        
        .presence-role-badge.admin {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }
        
        .presence-role-badge.operations {
            background: rgba(59, 130, 246, 0.15);
            color: #60a5fa;
        }
        
        .presence-role-badge.finance {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
        }
        
        /* Online status dot */
        .presence-status {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #22c55e;
            flex-shrink: 0;
            box-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
            animation: statusGlow 2s ease-in-out infinite;
        }
        
        @keyframes statusGlow {
            0%, 100% { box-shadow: 0 0 6px rgba(34, 197, 94, 0.4); }
            50% { box-shadow: 0 0 10px rgba(34, 197, 94, 0.6); }
        }
        
        /* Activity time */
        .presence-time {
            font-size: 10px;
            color: rgba(255, 255, 255, 0.35);
            white-space: nowrap;
        }
        
        /* Presence Toast Notifications */
        .presence-toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 9999;
            pointer-events: none;
        }
        
        .presence-toast {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            background: #1a1a1a;
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
            pointer-events: auto;
            animation: toastSlideIn 0.3s ease;
        }
        
        .presence-toast.toast-exit {
            animation: toastSlideOut 0.3s ease forwards;
        }
        
        @keyframes toastSlideIn {
            from {
                opacity: 0;
                transform: translateX(100%);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        @keyframes toastSlideOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }
            to {
                opacity: 0;
                transform: translateX(100%);
            }
        }
        
        .presence-toast-icon {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 600;
            background: linear-gradient(135deg, #f5a623, #fb923c);
            color: #1a1a1a;
        }
        
        .presence-toast-content {
            flex: 1;
        }
        
        .presence-toast-name {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
        }
        
        .presence-toast-message {
            font-size: 11px;
            color: var(--text-secondary);
        }
        
        .presence-toast-message.joined {
            color: #4ade80;
        }
        
        .presence-toast-message.left {
            color: #6b7280;
        }
        
        .presence-toast-close {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            padding: 4px;
            font-size: 14px;
            line-height: 1;
            transition: color 0.15s ease;
        }
        
        .presence-toast-close:hover {
            color: var(--text-primary);
        }
        
        /* Responsive Presence Styles */
        @media (max-width: 768px) {
            .presence-indicator {
                padding: 6px 10px;
                gap: 6px;
            }
            
            .presence-label {
                display: none;
            }
            
            .presence-dropdown {
                width: 300px;
                right: -10px;
            }
            
            .presence-item {
                padding: 8px 12px;
                margin: 2px 6px;
            }
            
            .presence-toast-container {
                bottom: 16px;
                right: 16px;
                left: 16px;
            }
            
            .presence-toast {
                width: 100%;
            }
        }
        
        @media (max-width: 480px) {
            .presence-dropdown {
                width: calc(100vw - 32px);
                right: -16px;
            }
            
            .presence-item {
                padding: 8px 10px;
            }
            
            .presence-avatar {
                width: 32px;
                height: 32px;
                font-size: 12px;
                border-radius: 8px;
            }
            
            .presence-role-badge {
                display: none;
            }
        }
        /* ===== End Presence Tracking Styles ===== */
        
        .search-input {
            padding: 8px 12px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-primary);
            font-size: 13px;
            width: 200px;
        }
        
        .search-input:focus { outline: none; border-color: var(--accent); }
        
        .card-content { padding: 16px 20px; max-height: 400px; overflow-y: auto; }
        
        .customer-bars { display: flex; flex-direction: column; gap: 12px; }
        
        .customer-bar {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .customer-bar-name {
            width: 140px;
            font-size: 13px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .customer-bar-track {
            flex: 1;
            height: 24px;
            background: var(--bg-tertiary);
            border-radius: 4px;
            overflow: hidden;
        }
        
        .customer-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), #fb923c);
