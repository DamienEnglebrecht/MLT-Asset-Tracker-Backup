        // Download POs as CSV
        function downloadPOsCSV() {
            const archivedJobCodes = archivedPOs.map(p => p.jobCode);
            const categoryFilter = document.getElementById('poCategoryFilter')?.value || 'all';
            
            const jobsMap = new Map();
            fleetData.forEach(t => {
                if (t.visionJob && t.poEnd && !archivedJobCodes.includes(t.visionJob)) {
                    const key = t.visionJob;
                    if (!jobsMap.has(key)) {
                        const poMatch = poData.find(p => p.poNumber === t.visionJob || p.poNumber === t.poNumber || (p.filename && p.filename.includes(t.visionJob)));
                        const category = poOverrides[key]?.category || poMatch?.category || t.category || 'Contract';
                        
                        const baseData = {
                            customer: t.customer || 'Unknown',
                            jobCode: t.visionJob,
                            poNumber: t.poNumber || '-',
                            location: t.location || t.site || '-',
                            poStart: t.poStart || '-',
                            poEnd: t.poEnd,
                            invoicingSchedule: t.invoicingSchedule || '-',
                            category: category,
                            towers: []
                        };
                        jobsMap.set(key, getPOWithOverrides(key, baseData));
                    }
                    jobsMap.get(key).towers.push(t);
                }
            });
            
            let jobs = Array.from(jobsMap.values());
            if (categoryFilter !== 'all') {
                jobs = jobs.filter(j => j.category === categoryFilter);
            }
            jobs.sort((a, b) => new Date(a.poEnd) - new Date(b.poEnd));
            
            // Build CSV
            const headers = ['Customer', 'Job Code', 'PO Number', 'Category', 'Location', 'Start Date', 'End Date', 'Days Left', 'Towers', 'Schedule'];
            const today = new Date();
            const rows = jobs.map(job => {
                const daysLeft = Math.ceil((new Date(job.poEnd) - today) / (1000 * 60 * 60 * 24));
                return [
                    job.customer,
                    job.jobCode,
                    job.poNumber,
                    job.category,
                    job.location,
                    job.poStart,
                    job.poEnd,
                    daysLeft < 0 ? 'Expired' : daysLeft,
                    job.towers.length,
                    job.invoicingSchedule
                ].map(v => '"' + String(v).replace(/"/g, '""') + '"').join(',');
            });
            
            const csv = [headers.join(','), ...rows].join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `PO_Management_${new Date().toISOString().split('T')[0]}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('CSV downloaded');
        }
        
