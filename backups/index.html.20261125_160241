        function filterTowerList() {
            const search = (document.getElementById('towerSearchInput')?.value || '').toLowerCase();
            const statusFilter = document.getElementById('towerStatusFilter')?.value || '';
            const customerFilter = document.getElementById('towerCustomerFilter')?.value || '';
            const siteFilter = document.getElementById('towerSiteFilter')?.value || '';
            const configFilter = document.getElementById('towerConfigFilter')?.value || '';
            const rateFilter = document.getElementById('towerRateFilter')?.value || '';
            
            towerListFiltered = fleetData.filter(t => {
                // Exclude sold/written off by default
                const status = (t.status || '').toUpperCase();
                if (status.includes('SOLD') || status.includes('WRITTEN')) return false;
                
                // Search
                if (search) {
                    const searchFields = [
                        t.id || t.tower_id || '',
                        t.customer || '',
                        t.site || t.location || '',
                        t.visionJob || '',
                        t.config || t.configuration || ''
                    ].join(' ').toLowerCase();
                    if (!searchFields.includes(search)) return false;
                }
                
                // Status filter
                if (statusFilter && !status.includes(statusFilter.toUpperCase())) return false;
                
                // Customer filter
                if (customerFilter && t.customer !== customerFilter) return false;
                
                // Site filter
                const towerSite = t.site || t.location || '';
                if (siteFilter && towerSite !== siteFilter) return false;
                
                // Config filter
                const towerConfig = t.config || t.configuration || '';
                if (configFilter && towerConfig !== configFilter) return false;
                
                // Rate filter
                const rate = parseFloat(t.rateDaily || t.daily_rate || 0);
                if (rateFilter) {
                    if (rateFilter === 'hasRate' && rate <= 0) return false;
                    if (rateFilter === 'noRate' && rate > 0) return false;
                    if (rateFilter === 'under50' && (rate <= 0 || rate >= 50)) return false;
                    if (rateFilter === '50to100' && (rate < 50 || rate > 100)) return false;
                    if (rateFilter === 'over100' && rate <= 100) return false;
                }
                
                return true;
            });
            
            // Sort
            towerListFiltered.sort((a, b) => {
                let aVal = a[towerListSortColumn] || '';
                let bVal = b[towerListSortColumn] || '';
                
                // Handle numeric for rate
                if (towerListSortColumn === 'rateDaily') {
                    aVal = parseFloat(a.rateDaily || a.daily_rate || 0);
                    bVal = parseFloat(b.rateDaily || b.daily_rate || 0);
                } else {
                    if (typeof aVal === 'string') aVal = aVal.toLowerCase();
                    if (typeof bVal === 'string') bVal = bVal.toLowerCase();
                }
                
                if (aVal < bVal) return towerListSortAsc ? -1 : 1;
                if (aVal > bVal) return towerListSortAsc ? 1 : -1;
                return 0;
            });
            
            towerListPage = 1;
            renderTowerTable();
        }
        
        function sortTowerList(column) {
            if (towerListSortColumn === column) {
                towerListSortAsc = !towerListSortAsc;
            } else {
                towerListSortColumn = column;
                towerListSortAsc = true;
            }
            filterTowerList();
        }
        
        function renderTowerTable() {
            const start = (towerListPage - 1) * towerListPageSize;
            const end = start + towerListPageSize;
            const pageData = towerListFiltered.slice(start, end);
            
            // Update counts
            const total = fleetData.filter(t => {
                const s = (t.status || '').toUpperCase();
                return !s.includes('SOLD') && !s.includes('WRITTEN');
            }).length;
            
            document.getElementById('towerShowingCount').textContent = towerListFiltered.length.toLocaleString();
            document.getElementById('towerTotalCount').textContent = total.toLocaleString();
            
            // Render table
            const tbody = document.getElementById('towerListTable');
            if (!pageData.length) {
                tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--text-muted);padding:40px">No towers match your filters</td></tr>';
                return;
            }
            
            tbody.innerHTML = pageData.map(t => {
                const status = (t.status || 'Unknown').toUpperCase();
                let statusClass = 'status-off-hire';
                let statusText = 'OFF HIRE';
                
                if (status.includes('ON HIRE')) { statusClass = 'status-on-hire'; statusText = 'ON HIRE'; }
                else if (status.includes('CONTRACT')) { statusClass = 'status-contract'; statusText = 'CONTRACT'; }
                else if (status.includes('REPAIR')) { statusClass = 'status-repairs'; statusText = 'REPAIRS'; }
                else if (status.includes('BUILD') || status.includes('FACTORY')) { statusClass = 'status-build'; statusText = 'IN BUILD'; }
                else if (status.includes('OFF HIRE')) { statusClass = 'status-off-hire'; statusText = 'OFF HIRE'; }
                else if (status.includes('SOLD')) { statusClass = 'status-sold'; statusText = 'SOLD'; }
                
                const dailyRate = parseFloat(t.rateDaily || t.daily_rate) || 0;
                const monthlyRate = parseFloat(t.rateMonthly || t.monthly_rate) || 0;
                
                // Determine billing type from invoicingSchedule field
                const schedule = (t.invoicingSchedule || '').toUpperCase();
                let billingType = '–';
                let billingClass = 'billing-none';
                let rateDisplay = '–';
                let rateClass = 'rate-cell no-rate';
                
                if (schedule === 'CONTRACT') {
                    billingType = 'Contract';
                    billingClass = 'billing-contract';
                    rateDisplay = monthlyRate > 0 ? `$${monthlyRate.toLocaleString('en-AU', {minimumFractionDigits: 2, maximumFractionDigits: 2})}` : '–';
                    rateClass = monthlyRate > 0 ? 'rate-cell' : 'rate-cell no-rate';
                } else if (schedule === 'MONTHLY' || monthlyRate > 0) {
                    billingType = 'Monthly';
                    billingClass = 'billing-monthly';
                    rateDisplay = `$${monthlyRate.toLocaleString('en-AU', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                    rateClass = 'rate-cell';
                } else if (schedule === 'WEEKLY') {
                    billingType = 'Weekly';
                    billingClass = 'billing-weekly';
                    rateDisplay = dailyRate > 0 ? `$${(dailyRate * 7).toLocaleString('en-AU', {minimumFractionDigits: 2, maximumFractionDigits: 2})}` : '–';
                    rateClass = dailyRate > 0 ? 'rate-cell' : 'rate-cell no-rate';
                } else if (schedule === 'DAILY' || dailyRate > 0) {
                    billingType = 'Daily';
                    billingClass = 'billing-daily';
                    rateDisplay = `$${dailyRate.toLocaleString('en-AU', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                    rateClass = 'rate-cell';
                }
                
                return `
                    <tr>
                        <td class="tower-id-cell">${t.id || t.tower_id || '–'}</td>
                        <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                        <td>${t.customer || '<span class="empty-cell">–</span>'}</td>
                        <td>${t.site || t.location || '<span class="empty-cell">–</span>'}</td>
                        <td>${t.visionJob || '<span class="empty-cell">–</span>'}</td>
                        <td><span class="billing-badge ${billingClass}">${billingType}</span></td>
                        <td class="${rateClass}">${rateDisplay}</td>
                        <td>${t.config || t.configuration || '<span class="empty-cell">–</span>'}</td>
                    </tr>
                `;
            }).join('');
            
            renderTowerPagination();
        }
        
        function renderTowerPagination() {
            const totalPages = Math.ceil(towerListFiltered.length / towerListPageSize);
            document.getElementById('towerCurrentPage').textContent = towerListPage;
            document.getElementById('towerTotalPages').textContent = totalPages || 1;
            
            let html = `<button onclick="goToTowerPage(${towerListPage - 1})" ${towerListPage === 1 ? 'disabled' : ''}>← Prev</button>`;
            
            const startPage = Math.max(1, towerListPage - 2);
            const endPage = Math.min(totalPages, startPage + 4);
            
            for (let i = startPage; i <= endPage; i++) {
                html += `<button onclick="goToTowerPage(${i})" class="${i === towerListPage ? 'active' : ''}">${i}</button>`;
