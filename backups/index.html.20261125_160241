        // Get ALL sites for a customer (including off-hire, used for Move Tower)
        function getAllSitesForCustomer(customer) {
            // Get sites from fleet data - ALL towers for this customer
            const fromFleet = fleetData
                .filter(t => t.customer === customer && t.site)
                .map(t => (t.site || '').trim())
                .filter(Boolean);
            // Also include custom sites added via Admin
            const fromCustom = customData.sites
                .filter(s => s.customer === customer)
                .map(s => (s.name || '').trim())
                .filter(Boolean);
            // Combine and deduplicate - use Map to normalize by lowercase key but preserve original case
            const siteMap = new Map();
            [...fromFleet, ...fromCustom].forEach(site => {
                const key = site.toLowerCase();
                if (!siteMap.has(key)) {
                    siteMap.set(key, site);
                }
            });
            return [...siteMap.values()].sort((a, b) => a.localeCompare(b, undefined, {sensitivity: 'base'}));
        }
        
