        // Subscribe to realtime PO document changes
        function subscribeToPODocs() {
            if (!supabaseClient) return;
            
            try {
                supabaseClient
                    .channel('po_documents_changes')
                    .on('postgres_changes', { event: '*', schema: 'public', table: 'po_documents' }, (payload) => {
                        console.log('PO document change:', payload);
                        if (payload.new) {
                            poDocuments[payload.new.job_code] = {
                                url: payload.new.file_url,
                                fileName: payload.new.file_name,
                                uploadedAt: payload.new.uploaded_at,
                                uploadedBy: payload.new.uploaded_by,
                                fromSupabase: true
                            };
                            localStorage.setItem('mlt_po_documents', JSON.stringify(poDocuments));
                            if (selectedJob === payload.new.job_code) {
                                loadPODocForJob(selectedJob);
                            }
                            showToast(`PO document synced: ${payload.new.file_name}`, 'success');
                        }
                    })
                    .subscribe();
            } catch (err) {
                console.log('Realtime subscription not available for po_documents');
            }
        }
        
        // Initialize PO docs sync
        loadPODocsFromSupabase();
        subscribeToPODocs();
        
        // =============================================
        // PO DOCUMENT UPLOAD - SUPABASE STORAGE BUCKET
        // =============================================
        const PO_STORAGE_BUCKET = 'po-documents';
        
        async function uploadPODocument(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            if (!selectedJob) {
                showToast('Please select a job first', 'error');
                return;
            }
            
            // Validate file type
            const validTypes = ['application/pdf', 'image/png', 'image/jpeg', 'image/jpg'];
            if (!validTypes.includes(file.type)) {
                showToast('Please upload a PDF or image file (PNG, JPG)', 'error');
                return;
            }
            
            // Validate file size (max 50MB - storage bucket supports larger files)
            if (file.size > 50 * 1024 * 1024) {
                showToast('File too large. Maximum size is 50MB', 'error');
                return;
            }
            
            const section = document.getElementById('poDocumentSection');
            section.classList.add('po-doc-uploading');
            document.getElementById('poDocText').textContent = 'Uploading to secure storage...';
            
            try {
                // Generate unique file path: customer/job_timestamp.ext
                const timestamp = Date.now();
                const ext = file.name.split('.').pop();
                const storagePath = `${selectedCustomer.replace(/[^a-zA-Z0-9]/g, '_')}/${selectedJob}_${timestamp}.${ext}`;
                
                // 1. UPLOAD TO SUPABASE STORAGE BUCKET
                const { data: uploadData, error: uploadError } = await supabaseClient
                    .storage
                    .from(PO_STORAGE_BUCKET)
                    .upload(storagePath, file, {
                        cacheControl: '3600',
                        upsert: true
                    });
                
                if (uploadError) {
                    console.error('Storage upload failed:', uploadError);
                    throw new Error('File upload failed: ' + (uploadError.message || uploadError.code));
                }
                
                // 2. GET PUBLIC URL
                const { data: urlData } = supabaseClient
                    .storage
                    .from(PO_STORAGE_BUCKET)
                    .getPublicUrl(storagePath);
                
                const publicUrl = urlData.publicUrl;
                console.log('File uploaded to storage:', publicUrl);
                
                // 3. SAVE REFERENCE TO DATABASE
                const docData = {
                    url: publicUrl,
                    storagePath: storagePath,
                    fileName: file.name,
                    uploadedAt: new Date().toISOString(),
                    uploadedBy: currentUser?.name || 'Unknown',
                    type: file.type,
                    isBase64: false,
                    size: file.size
                };
                
                await savePODocReference(selectedJob, docData);
                
                // 4. Update local cache
                poDocuments[selectedJob] = docData;
                localStorage.setItem('mlt_po_documents', JSON.stringify(poDocuments));
                
                // 5. Log to activity feed
                await logActivity('Uploaded PO document', `${file.name} for job ${selectedJob}`, null, selectedCustomer, 'Finance');
                
                currentPODocUrl = publicUrl;
                updatePODocUI(true, file.name);
                section.classList.remove('po-doc-uploading');
                showToast('PO uploaded to secure storage ✓');
                
            } catch (err) {
                console.error('Upload error:', err);
                showToast('Upload failed: ' + (err.message || 'Unknown error'), 'error');
                section.classList.remove('po-doc-uploading');
            }
            
            event.target.value = ''; // Reset file input
        }
        
        async function savePODocReference(jobCode, docData) {
            if (!supabaseClient) {
                throw new Error('Not connected to server');
            }
            
            // Delete existing record first to avoid constraint issues
            await supabaseClient.from('po_documents').delete().eq('job_code', jobCode);
            
            const { error } = await supabaseClient
                .from('po_documents')
                .insert({
                    job_code: jobCode,
                    po_key: `${selectedCustomer}_${selectedSite}_${jobCode}`,
                    customer: selectedCustomer,
                    site: selectedSite,
                    filename: docData.fileName,
                    file_url: docData.url,
                    storage_path: docData.storagePath || null,
                    file_name: docData.fileName,
                    uploaded_by: docData.uploadedBy,
                    uploaded_at: docData.uploadedAt,
                    file_type: docData.type,
                    file_size: docData.size || null
                });
            
            if (error) {
                console.error('Supabase PO save failed:', error);
                throw new Error('Server save failed: ' + (error.message || error.code));
            }
            
            console.log('PO doc reference saved to database for job:', jobCode);
        }
        
