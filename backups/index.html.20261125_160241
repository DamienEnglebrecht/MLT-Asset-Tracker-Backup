        async function savePOEdit(jobCode) {
            const override = {
                customer: document.getElementById('editPOCustomer').value,
                poNumber: document.getElementById('editPONumber').value,
                category: document.getElementById('editPOCategory').value,
                location: document.getElementById('editPOLocation').value,
                poStart: document.getElementById('editPOStart').value,
                poEnd: document.getElementById('editPOEnd').value,
                invoicingSchedule: document.getElementById('editPOSchedule').value
            };
            
            // Save to Supabase
            if (supabaseClient) {
                // Delete existing then insert (upsert)
                await supabaseClient.from('po_overrides').delete().eq('job_code', jobCode);
                const { error } = await supabaseClient.from('po_overrides').insert({
                    job_code: jobCode,
                    customer: override.customer,
                    po_number: override.poNumber,
                    category: override.category,
                    location: override.location,
                    po_start: override.poStart,
                    po_end: override.poEnd,
                    invoicing_schedule: override.invoicingSchedule,
                    updated_by: currentUser.name,
                    updated_at: new Date().toISOString()
                });
                
                if (error) {
                    console.error('Failed to save PO edit:', error);
                    showToast('Failed to save changes', 'error');
                    return;
                }
            }
            
            // Update local state
