<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <meta name="app-version" content="2026.11.25.04">
    <title>MLT Asset Tracker</title>
    <script>
        // Force reload if version changed
        const APP_VERSION = '2026.11.25.04';
        const storedVersion = localStorage.getItem('mlt_app_version');
        if (storedVersion && storedVersion !== APP_VERSION) {
            localStorage.setItem('mlt_app_version', APP_VERSION);
            location.reload(true);
        } else {
            localStorage.setItem('mlt_app_version', APP_VERSION);
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --bg-primary: #0a0a0a;
            --bg-secondary: #111111;
            --bg-tertiary: #1a1a1a;
            --bg-hover: #222222;
            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --text-muted: #666666;
            --accent: #f97316;
            --accent-hover: #ea580c;
            --success: #22c55e;
            --warning: #eab308;
            --danger: #ef4444;
            --border: #2a2a2a;
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
        }
        
        /* Login Screen */
        .login-screen {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .login-box {
            background: var(--bg-secondary);
            padding: 48px;
            border-radius: 16px;
            border: 1px solid var(--border);
            width: 100%;
            max-width: 400px;
            text-align: center;
        }
        
        .login-logo {
            width: 80px;
            height: 80px;
            background: var(--accent);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            margin: 0 auto 24px;
        }
        
        .login-title { font-size: 24px; margin-bottom: 8px; font-weight: 600; }
        .login-subtitle { color: var(--text-secondary); margin-bottom: 32px; }
        
        .login-input {
            width: 100%;
            padding: 14px 16px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 16px;
            text-align: center;
            letter-spacing: 1px;
            margin-bottom: 16px;
        }
        
        .login-input:focus { outline: none; border-color: var(--accent); }
        .login-input::placeholder { letter-spacing: normal; }
        
        .login-btn {
            width: 100%;
            padding: 14px;
            background: var(--accent);
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }
        
        .login-btn:hover { background: var(--accent-hover); }
        .login-error { color: var(--danger); margin-top: 16px; display: none; }
        .login-security { margin-top: 24px; font-size: 12px; color: var(--text-muted); }
        
        .hidden { display: none !important; }
        
        /* Main Layout */
        .app-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        /* Top Bar */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 24px;
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border);
            gap: 20px;
        }
        
        .topbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .logo {
            width: 40px;
            height: 40px;
            background: var(--accent);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
        }
        
        .logo-text { font-size: 18px; font-weight: 700; }
        .logo-sub { font-size: 11px; color: var(--text-secondary); }
        
        .live-clock {
            margin-left: 24px;
            padding-left: 24px;
            border-left: 1px solid var(--border);
            text-align: center;
        }
        
        .clock-time {
            font-size: 20px;
            font-weight: 700;
            color: #ff6b35;
            font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;
            letter-spacing: 1px;
        }
        
        .clock-date {
            font-size: 11px;
            color: var(--text-secondary);
            margin-top: 2px;
        }
        
        /* Nav Tabs */
        .nav-tabs {
            display: flex;
            gap: 8px;
        }
        
        .nav-tab {
            padding: 10px 20px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }
        
        .nav-tab:hover { background: var(--bg-tertiary); color: var(--text-primary); }
        .nav-tab.active { background: var(--accent); border-color: var(--accent); color: white; }
        
        /* User */
        .topbar-user {
            display: flex;
            align-items: center;
            gap: 16px;
            background: linear-gradient(135deg, rgba(255,107,53,0.1), rgba(255,107,53,0.05));
            padding: 8px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255,107,53,0.2);
        }
        
        .user-info-block {
            text-align: right;
        }
        
        .user-name { font-weight: 600; font-size: 15px; color: #fff; }
        .user-role { 
            font-size: 10px; 
            color: var(--accent); 
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
            background: rgba(255,107,53,0.2);
            padding: 2px 8px;
            border-radius: 4px;
            display: inline-block;
            margin-top: 2px;
        }
        
        .user-avatar {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--accent), #ff8f5a);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            color: #fff;
            box-shadow: 0 2px 8px rgba(255,107,53,0.3);
        }
        
        .logout-btn {
            padding: 8px 14px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-secondary);
            font-size: 13px;
            cursor: pointer;
        }
        
        .logout-btn:hover { background: var(--bg-tertiary); color: var(--text-primary); }
        
        /* Main Wrapper */
        .main-wrapper {
            display: flex;
            flex: 1;
            overflow: hidden;
        }
        
        .main-content-area {
            display: flex;
            flex: 1;
            overflow: hidden;
        }
        
        /* Global Activity Sidebar */
        .global-activity-sidebar {
            width: 280px;
            min-width: 280px;
            background: var(--bg-secondary);
            border-left: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        .global-activity-sidebar .sidebar-header {
            padding: 16px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-primary);
        }
        
        .global-activity-sidebar .sidebar-header h3 {
            margin: 0;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .global-activity-sidebar .live-badge {
            background: #dc2626;
            color: white;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }
        
        .global-activity-sidebar .sidebar-content {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
        }
        
        .global-activity-sidebar .activity-item {
            padding: 10px 12px;
            background: var(--bg-primary);
            border-radius: 8px;
            margin-bottom: 8px;
            border-left: 3px solid var(--accent);
        }
        
        .global-activity-sidebar .activity-item.login {
            border-left-color: #4ade80;
        }
        
        .global-activity-sidebar .activity-item.logout {
            border-left-color: #f87171;
        }
        
        .global-activity-sidebar .activity-item.tower-move {
            border-left-color: #60a5fa;
        }
        
        .global-activity-sidebar .activity-item.po-upload {
            border-left-color: #c084fc;
        }
        
        .global-activity-sidebar .activity-item.invoice {
            border-left-color: #fbbf24;
        }
        
        .global-activity-sidebar .activity-user {
            font-weight: 600;
            color: var(--accent);
            font-size: 12px;
        }
        
        .global-activity-sidebar .activity-action {
            color: var(--text-primary);
            font-size: 12px;
            margin-top: 2px;
        }
        
        .global-activity-sidebar .activity-details {
            color: var(--text-muted);
            font-size: 11px;
            margin-top: 4px;
        }
        
        .global-activity-sidebar .activity-time {
            color: var(--text-muted);
            font-size: 10px;
            margin-top: 4px;
        }
        
        .global-activity-sidebar .no-activity {
            text-align: center;
            color: var(--text-muted);
            padding: 40px 20px;
            font-size: 13px;
        }
        
        .view { display: none; flex: 1; overflow: hidden; }
        .view.active { display: flex; }
        
        /* Column Panel */
        .column-panel {
            width: 240px;
            min-width: 200px;
            background: var(--bg-secondary);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        .column-panel.wide { width: 300px; }
        
        .column-header {
            padding: 16px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .column-title {
            font-size: 11px;
            font-weight: 600;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .column-content {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
        }
        
        .column-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.15s;
            margin-bottom: 4px;
        }
        
        .column-item:hover { background: var(--bg-tertiary); }
        .column-item.active { background: var(--bg-tertiary); border-left: 3px solid var(--accent); }
        
        .column-item-name { font-size: 14px; font-weight: 500; }
        .column-item-sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
        .column-item-count {
            font-size: 12px;
            color: var(--text-muted);
            background: var(--bg-primary);
            padding: 2px 8px;
            border-radius: 4px;
        }
        .column-item-count.money { color: var(--success); background: rgba(34,197,94,0.1); }
        
        .add-btn {
            width: 100%;
            padding: 10px;
            background: transparent;
            border: 1px dashed var(--border);
            border-radius: 8px;
            color: var(--text-muted);
            font-size: 13px;
            cursor: pointer;
            margin-top: 8px;
            transition: all 0.15s;
        }
        
        .add-btn:hover { border-color: var(--accent); color: var(--accent); }
        
        /* Finance Header & Tabs */
        .finance-header {
            display: none; /* Hide when not needed */
        }
        
        .finance-subtabs {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            background: var(--bg-tertiary);
            border-bottom: 1px solid var(--border);
        }
        
        .finance-subtabs .finance-tabs {
            display: flex;
            gap: 8px;
        }
        
        .finance-subtabs .finance-filters {
            display: flex;
            gap: 12px;
            margin-left: auto;
        }
        
        .finance-tab {
            padding: 10px 16px;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 8px;
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s;
        }
        
        .finance-tab:hover { background: var(--bg-tertiary); color: var(--text-primary); }
        .finance-tab.active { background: var(--accent); color: white; border-color: var(--accent); }
        
        .finance-filters {
            display: flex;
            gap: 12px;
        }
        
        .finance-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        .finance-content.hidden { display: none; }
        
        .finance-columns {
            display: flex;
            flex: 1;
            overflow: hidden;
        }
        
        /* Revenue Tab */
        .revenue-container {
            padding: 24px;
            overflow-y: auto;
        }
        
        .revenue-summary {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }
        
        .revenue-card {
            background: var(--bg-secondary);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }
        
        .revenue-label {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        
        .revenue-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--success);
        }
        
        /* PO Management Tab */
        .po-management-container {
            padding: 24px;
            overflow-y: auto;
        }
        
        .po-alerts-section {
            margin-bottom: 32px;
        }
        
        .po-alerts-section h3 {
            margin-bottom: 16px;
            font-size: 16px;
        }
        
        .po-alert-cards {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
        }
        
        .po-alert-card {
            background: var(--bg-secondary);
            padding: 16px;
            border-radius: 12px;
            border-left: 4px solid var(--warning);
        }
        
        .po-alert-card.expired { border-left-color: var(--danger); }
        .po-alert-card.expiring-soon { border-left-color: var(--warning); }
        
        .po-alert-customer {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 4px;
        }
        
        .po-alert-job {
            color: var(--accent);
            font-size: 13px;
            margin-bottom: 8px;
        }
        
        .po-alert-info {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 12px;
        }
        
        .po-alert-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
        }
        
        .po-alert-badge.expired { background: rgba(239, 68, 68, 0.2); color: var(--danger); }
        .po-alert-badge.warning { background: rgba(234, 179, 8, 0.2); color: var(--warning); }
        
        /* Category Badges */
        .category-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .category-badge.category-contract {
            background: rgba(59, 130, 246, 0.2);
            color: #3B82F6;
        }
        .category-badge.category-hire {
            background: rgba(16, 185, 129, 0.2);
            color: #10B981;
        }
        .category-badge.category-shutdown {
            background: rgba(249, 115, 22, 0.2);
            color: #F97316;
        }
        
        .po-table-section h3 {
            margin-bottom: 16px;
            font-size: 16px;
        }
        
        /* Archive Tab */
        .archive-container {
            padding: 24px;
            overflow-y: auto;
        }
        
        .archive-header {
            margin-bottom: 24px;
        }
        
        .archive-header h3 {
            font-size: 18px;
            margin-bottom: 4px;
        }
        
        /* Internal Fleet Tab */
        .internal-fleet-container {
            padding: 24px;
            overflow-y: auto;
            flex: 1;
        }
        
        .internal-fleet-header {
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        
        .internal-fleet-header h3 {
            font-size: 18px;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .internal-fleet-badge {
            background: linear-gradient(135deg, #f97316, #ff8f5a);
            color: white;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }
        
        .internal-fleet-stats {
            display: flex;
            gap: 16px;
            margin-bottom: 24px;
        }
        
        .internal-stat {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 16px 24px;
            text-align: center;
        }
        
        .internal-stat-value {
            font-size: 24px;
            font-weight: 700;
            color: var(--accent);
        }
        
        .internal-stat-label {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 4px;
        }
        
        .internal-tower-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-left: 4px solid var(--accent);
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 12px;
        }
        
        .internal-tower-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        
        .internal-tower-id {
            font-weight: 600;
            font-size: 16px;
            color: var(--accent);
        }
        
        .internal-tower-status {
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .internal-tower-status.off-hire {
            background: rgba(234, 179, 8, 0.2);
            color: #eab308;
        }
        
        .internal-tower-status.in-repair {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }
        
        .internal-tower-status.in-build {
            background: rgba(96, 165, 250, 0.2);
            color: #60a5fa;
        }
        
        .internal-tower-status.available {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }
        
        .internal-tower-details {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-top: 12px;
        }
        
        .internal-tower-detail {
            font-size: 13px;
        }
        
        .internal-tower-detail .label {
            color: var(--text-muted);
            font-size: 11px;
            margin-bottom: 2px;
        }
        
        .internal-tower-detail .value {
            color: var(--text-primary);
            font-weight: 500;
        }
        
        /* Invoice Panel */
        .invoice-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--bg-primary);
        }
        
        .invoice-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-secondary);
        }
        
        .invoice-title { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
        .invoice-subtitle { color: var(--text-secondary); font-size: 14px; }
        .invoice-po { color: var(--accent); font-size: 13px; margin-top: 4px; }
        .po-number-edit { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
        .po-label { color: #888; font-size: 13px; }
        .po-value { color: var(--accent); font-size: 13px; cursor: pointer; }
        .po-value:hover { text-decoration: underline; }
        .btn-edit-po { background: transparent; border: none; cursor: pointer; font-size: 12px; opacity: 0.6; padding: 2px; }
        .btn-edit-po:hover { opacity: 1; }
        .po-number-input { display: flex; align-items: center; gap: 6px; margin-top: 4px; }
        .po-number-input.hidden { display: none !important; }
        .po-number-input input { background: #2a2a2a; border: 1px solid #444; border-radius: 4px; color: #fff; padding: 6px 10px; font-size: 13px; width: 180px; }
        .po-number-input input:focus { border-color: var(--accent); outline: none; }
        .btn-save-po { background: #28a745; border: none; border-radius: 4px; color: #fff; cursor: pointer; padding: 6px 12px; font-size: 16px; font-weight: bold; min-width: 36px; }
        .btn-save-po:hover { background: #218838; }
        .btn-cancel-po { background: #666; border: none; border-radius: 4px; color: #fff; cursor: pointer; padding: 6px 12px; font-size: 16px; font-weight: bold; min-width: 36px; }
        .btn-cancel-po:hover { background: #555; }
        
        /* PO Document Upload Section */
        .po-document-section {
            margin-top: 12px;
            padding: 10px;
            background: var(--bg-tertiary);
            border-radius: 8px;
            border: 1px solid var(--border);
        }
        .po-doc-status {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }
        .po-doc-icon { font-size: 16px; }
        .po-doc-text { font-size: 12px; color: var(--text-muted); }
        .po-doc-text.uploaded { color: var(--success); font-weight: 500; }
        .po-doc-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .btn-small {
            padding: 6px 10px;
            font-size: 11px;
            border-radius: 4px;
            border: none;
            background: var(--bg-secondary);
            color: var(--text-primary);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .btn-small:hover { background: var(--border); }
