        // Utilisation Chart
        function renderUtilisationChart(totalFleet, onHire) {
            const canvas = document.getElementById('utilisationCanvas');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            const container = canvas.parentElement;
            
            // Set canvas size
            canvas.width = container.offsetWidth - 32;
            canvas.height = 180;
            
            const width = canvas.width;
            const height = canvas.height;
            const padding = { top: 20, right: 20, bottom: 30, left: 50 };
            const chartWidth = width - padding.left - padding.right;
            const chartHeight = height - padding.top - padding.bottom;
            
            // Generate mock historical data (12 weeks)
            const weeks = 12;
            const data = [];
            const currentUtil = (onHire / totalFleet) * 100;
            
            for (let i = weeks - 1; i >= 0; i--) {
                // Create realistic fluctuation around current utilisation
                const variance = (Math.random() - 0.5) * 10;
                const util = Math.max(60, Math.min(95, currentUtil + variance - (i * 0.3)));
                data.push({
                    week: `W${weeks - i}`,
                    onHire: Math.round((util / 100) * totalFleet),
                    available: totalFleet - Math.round((util / 100) * totalFleet),
                    util: util
                });
            }
            // Last point is current actual
            data[data.length - 1] = {
                week: 'Now',
                onHire: onHire,
                available: totalFleet - onHire,
                util: currentUtil
            };
            
            // Clear canvas
            ctx.clearRect(0, 0, width, height);
            
            // Draw grid lines
            ctx.strokeStyle = 'rgba(255,255,255,0.1)';
            ctx.lineWidth = 1;
            for (let i = 0; i <= 4; i++) {
                const y = padding.top + (chartHeight / 4) * i;
                ctx.beginPath();
                ctx.moveTo(padding.left, y);
                ctx.lineTo(width - padding.right, y);
                ctx.stroke();
            }
            
            // Y-axis labels
            ctx.fillStyle = 'rgba(255,255,255,0.5)';
            ctx.font = '10px system-ui';
            ctx.textAlign = 'right';
            for (let i = 0; i <= 4; i++) {
                const y = padding.top + (chartHeight / 4) * i;
                const val = 100 - (i * 25);
                ctx.fillText(val + '%', padding.left - 8, y + 3);
            }
            
            // Calculate points
            const points = data.map((d, i) => ({
                x: padding.left + (chartWidth / (weeks - 1)) * i,
                y: padding.top + chartHeight - (d.util / 100) * chartHeight
            }));
            
            // Draw area fill (gradient)
            const gradient = ctx.createLinearGradient(0, padding.top, 0, height - padding.bottom);
            gradient.addColorStop(0, 'rgba(255, 107, 53, 0.3)');
            gradient.addColorStop(1, 'rgba(255, 107, 53, 0)');
            
            ctx.beginPath();
            ctx.moveTo(points[0].x, height - padding.bottom);
            points.forEach(p => ctx.lineTo(p.x, p.y));
            ctx.lineTo(points[points.length - 1].x, height - padding.bottom);
            ctx.closePath();
            ctx.fillStyle = gradient;
            ctx.fill();
            
            // Draw line
            ctx.beginPath();
            ctx.moveTo(points[0].x, points[0].y);
            for (let i = 1; i < points.length; i++) {
                const xc = (points[i - 1].x + points[i].x) / 2;
                const yc = (points[i - 1].y + points[i].y) / 2;
                ctx.quadraticCurveTo(points[i - 1].x, points[i - 1].y, xc, yc);
            }
            ctx.lineTo(points[points.length - 1].x, points[points.length - 1].y);
            ctx.strokeStyle = '#ff6b35';
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.stroke();
            
            // Draw points
            points.forEach((p, i) => {
                ctx.beginPath();
                ctx.arc(p.x, p.y, i === points.length - 1 ? 6 : 4, 0, Math.PI * 2);
                ctx.fillStyle = i === points.length - 1 ? '#ff6b35' : '#1a1a1a';
                ctx.fill();
                ctx.strokeStyle = '#ff6b35';
                ctx.lineWidth = 2;
                ctx.stroke();
            });
            
            // Current value label
            const lastPoint = points[points.length - 1];
            ctx.fillStyle = '#ff6b35';
            ctx.font = 'bold 12px system-ui';
            ctx.textAlign = 'center';
            ctx.fillText(currentUtil.toFixed(1) + '%', lastPoint.x, lastPoint.y - 12);
            
            // X-axis labels (every 3rd week)
            ctx.fillStyle = 'rgba(255,255,255,0.5)';
            ctx.font = '10px system-ui';
            ctx.textAlign = 'center';
            data.forEach((d, i) => {
                if (i % 3 === 0 || i === data.length - 1) {
                    const x = padding.left + (chartWidth / (weeks - 1)) * i;
                    ctx.fillText(d.week, x, height - 8);
                }
            });
        }
        
        // Load sidebar activity feed
        async function loadDashboardActivity() {
            const globalFeedEl = document.getElementById('globalActivityFeed');
            if (!globalFeedEl) return;
            
            try {
                const response = await fetch(`${SUPABASE_URL}/rest/v1/activity_feed?action=not.ilike.*login*&action=not.ilike.*logged*&order=created_at.desc&limit=20`, {
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`
                    }
                });
                
                if (response.ok) {
                    const activities = await response.json();
                    renderGlobalActivityFeed(activities);
                } else {
                    globalFeedEl.innerHTML = '<div class="no-activity">Unable to load activity</div>';
                }
            } catch (err) {
                console.error('Activity feed error:', err);
                globalFeedEl.innerHTML = '<div class="no-activity">Unable to load activity</div>';
            }
        }
        
        function renderGlobalActivityFeed(activities) {
            const globalFeedEl = document.getElementById('globalActivityFeed');
            if (!globalFeedEl) return;
            
            if (!activities || activities.length === 0) {
                globalFeedEl.innerHTML = '<div class="no-activity">No recent activity</div>';
                return;
            }
            
            globalFeedEl.innerHTML = activities.slice(0, 15).map((item, idx) => {
                const time = new Date(item.created_at);
                const timeAgo = getActivityTimeAgo(time);
                
                // Determine activity type for color coding
                let activityType = '';
                const actionLower = (item.action || '').toLowerCase();
                if (actionLower.includes('move') || actionLower.includes('tower')) activityType = 'tower-move';
                else if (actionLower.includes('po') || actionLower.includes('upload')) activityType = 'po-upload';
                else if (actionLower.includes('invoice') || actionLower.includes('approv')) activityType = 'invoice';
                
                return `
                    <div class="activity-item ${activityType}">
                        <div class="activity-user">${item.user_name || 'System'}</div>
                        <div class="activity-action">${item.action || 'Activity'}</div>
                        ${item.details ? `<div class="activity-details">${item.details}</div>` : ''}
                        <div class="activity-time">${timeAgo}</div>
                    </div>
                `;
            }).join('');
        }
        
        function getActivityTimeAgo(date) {
            const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
            if (seconds < 60) return 'Just now';
            if (seconds < 3600) return Math.floor(seconds / 60) + ' mins ago';
            if (seconds < 86400) return Math.floor(seconds / 3600) + ' hours ago';
            return Math.floor(seconds / 86400) + ' days ago';
        }
        
        function subscribeToActivityFeed() {
            if (!supabaseClient) return;
            
            // Realtime subscription for instant updates
            supabaseClient
                .channel('activity_changes')
                .on('postgres_changes', 
                    { event: 'INSERT', schema: 'public', table: 'activity_feed' },
