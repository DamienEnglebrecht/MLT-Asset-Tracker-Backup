        // Revenue Functions
        function renderRevenue() {
            const onHire = fleetData.filter(t => (t.status || '').toUpperCase().includes('ON HIRE'));
            
            let totalWeekly = 0;
            let totalMonthly = 0;
            let dailyRates = [];
            
            // Group by customer
            const customerRevenue = {};
            
            onHire.forEach(t => {
                const customer = t.customer || 'Unknown';
                const daily = parseFloat(t.rateDaily) || 0;
                const monthly = parseFloat(t.rateMonthly) || 0;
                const schedule = (t.invoicingSchedule || '').toUpperCase();
                
                if (!customerRevenue[customer]) {
                    customerRevenue[customer] = {
                        towers: 0,
                        weeklyCount: 0,
                        monthlyCount: 0,
                        weeklyRevenue: 0,
                        monthlyRevenue: 0
                    };
                }
                
                customerRevenue[customer].towers++;
                
                if (schedule === 'WEEKLY') {
                    customerRevenue[customer].weeklyCount++;
                    customerRevenue[customer].weeklyRevenue += daily * 7;
                    totalWeekly += daily * 7;
                } else if (schedule === 'MONTHLY') {
                    customerRevenue[customer].monthlyCount++;
                    customerRevenue[customer].monthlyRevenue += monthly;
                    totalMonthly += monthly;
                } else {
                    // Default calculation
                    if (daily > 0) {
                        customerRevenue[customer].weeklyRevenue += daily * 7;
                        totalWeekly += daily * 7;
                    }
                }
                
                if (daily > 0) dailyRates.push(daily);
            });
            
            // Update summary cards
            document.getElementById('weeklyRevenue').textContent = '$' + totalWeekly.toLocaleString('en-AU', {minimumFractionDigits: 0, maximumFractionDigits: 0});
            document.getElementById('monthlyRevenue').textContent = '$' + totalMonthly.toLocaleString('en-AU', {minimumFractionDigits: 0, maximumFractionDigits: 0});
            document.getElementById('activeTowers').textContent = onHire.length;
            
            const avgRate = dailyRates.length > 0 ? dailyRates.reduce((a,b) => a+b, 0) / dailyRates.length : 0;
            document.getElementById('avgDailyRate').textContent = '$' + avgRate.toFixed(2);
            
            // Build revenue table
            let tableHtml = '';
            Object.keys(customerRevenue).sort().forEach(customer => {
                const c = customerRevenue[customer];
                tableHtml += `
                    <tr>
                        <td>${customer}</td>
                        <td>${c.towers}</td>
                        <td>${c.weeklyCount}</td>
                        <td>${c.monthlyCount}</td>
                        <td class="money">$${c.weeklyRevenue.toLocaleString('en-AU', {minimumFractionDigits: 0})}</td>
                        <td class="money">$${c.monthlyRevenue.toLocaleString('en-AU', {minimumFractionDigits: 0})}</td>
                    </tr>
                `;
            });
            
            document.getElementById('revenueTable').innerHTML = tableHtml || '<tr><td colspan="6" style="text-align:center">No revenue data</td></tr>';
        }
        
