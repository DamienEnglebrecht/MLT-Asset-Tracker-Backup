        // PO Management Functions
        function renderPOManagement() {
            const today = new Date();
            const alertsContainer = document.getElementById('poExpiryAlerts');
            const tableBody = document.getElementById('poManagementTable');
            
            // Get list of archived job codes
            const archivedJobCodes = archivedPOs.map(p => p.jobCode);
            
            // Get category filter
            const categoryFilter = document.getElementById('poCategoryFilter')?.value || 'all';
            
            // Get all unique jobs with PO info from fleet data (excluding archived)
            const jobsMap = new Map();
            fleetData.forEach(t => {
                if (t.visionJob && t.poEnd && !archivedJobCodes.includes(t.visionJob)) {
                    const key = t.visionJob;
                    if (!jobsMap.has(key)) {
                        // Find matching PO data for category
                        const poMatch = poData.find(p => 
                            p.poNumber === t.visionJob || 
                            p.poNumber === t.poNumber ||
                            (p.filename && p.filename.includes(t.visionJob))
                        );
                        const baseCategory = poMatch?.category || t.category || 'Contract';
                        
                        // Check for overrides
                        const override = poOverrides[key] || {};
                        
                        jobsMap.set(key, {
                            customer: override.customer || t.customer || 'Unknown',
                            jobCode: t.visionJob,
                            poNumber: override.poNumber || t.poNumber || '-',
                            location: override.location || t.location || t.site || '-',
                            poStart: override.poStart || t.poStart || '-',
                            poEnd: override.poEnd || t.poEnd,
                            invoicingSchedule: override.invoicingSchedule || t.invoicingSchedule || '-',
                            category: override.category || baseCategory,
                            towers: []
                        });
                    }
                    jobsMap.get(key).towers.push(t);
                }
            });
            
            let jobs = Array.from(jobsMap.values());
            
            // Add manually created POs (not tied to tower data)
            manualPOs.forEach(po => {
                // Skip if already archived
                if (archivedJobCodes.includes(po.jobCode)) return;
                
                jobs.push({
                    customer: po.customer,
                    jobCode: po.jobCode,
                    poNumber: po.poNumber,
                    location: po.location,
                    poStart: po.poStart,
                    poEnd: po.poEnd,
                    invoicingSchedule: po.invoicingSchedule,
                    category: po.category,
                    towers: po.towers || [],
                    isManual: true,
                    description: po.description,
                    notes: po.notes
                });
            });
            
            // Filter by category
            if (categoryFilter !== 'all') {
                jobs = jobs.filter(j => j.category === categoryFilter);
            }
            
            // Sort by end date (soonest first)
            jobs.sort((a, b) => new Date(a.poEnd) - new Date(b.poEnd));
            
            // Build alerts for expiring/expired POs
            let alertsHtml = '';
            jobs.forEach(job => {
                const endDate = new Date(job.poEnd);
                const daysLeft = Math.ceil((endDate - today) / (1000 * 60 * 60 * 24));
                
                if (daysLeft <= 30) {
                    const isExpired = daysLeft < 0;
                    const categoryBadge = `<span class="category-badge category-${job.category.toLowerCase()}">${job.category}</span>`;
                    alertsHtml += `
                        <div class="po-alert-card ${isExpired ? 'expired' : 'expiring-soon'}">
                            <div class="po-alert-customer">${job.customer} ${categoryBadge}</div>
                            <div class="po-alert-job">${job.jobCode} - ${job.location}</div>
                            <div class="po-alert-info">PO: ${job.poNumber} | ${job.towers.length} towers</div>
                            <span class="po-alert-badge ${isExpired ? 'expired' : 'warning'}">
                                ${isExpired ? 'EXPIRED ' + Math.abs(daysLeft) + ' days ago' : daysLeft + ' days left'}
                            </span>
                            <button class="btn small" style="margin-left:12px" onclick="archivePO('${job.jobCode}')">Archive</button>
                        </div>
                    `;
                }
            });
            
            alertsContainer.innerHTML = alertsHtml || '<p style="color:var(--text-secondary)">No POs expiring within 30 days</p>';
            
            // Build table
            let tableHtml = '';
            jobs.forEach(job => {
                const endDate = new Date(job.poEnd);
                const daysLeft = Math.ceil((endDate - today) / (1000 * 60 * 60 * 24));
                const daysClass = daysLeft < 0 ? 'color:var(--danger)' : daysLeft <= 14 ? 'color:var(--warning)' : '';
                const categoryBadge = `<span class="category-badge category-${job.category.toLowerCase()}">${job.category}</span>`;
                
                tableHtml += `
                    <tr>
                        <td>${job.customer}</td>
                        <td>${job.jobCode}</td>
                        <td>${job.poNumber}</td>
                        <td>${categoryBadge}</td>
                        <td>${job.location}</td>
                        <td>${job.poStart}</td>
                        <td>${job.poEnd}</td>
                        <td style="${daysClass};font-weight:600">${daysLeft < 0 ? 'Expired' : daysLeft + ' days'}</td>
                        <td>${job.towers.length}</td>
                        <td>${job.invoicingSchedule}</td>
                        <td>
                            <button class="btn small" onclick="editPO('${job.jobCode}')">Edit</button>
                            <button class="btn small" onclick="archivePO('${job.jobCode}')">Archive</button>
                        </td>
                    </tr>
                `;
            });
            
            tableBody.innerHTML = tableHtml || '<tr><td colspan="11" style="text-align:center;color:var(--text-secondary)">No active POs with end dates</td></tr>';
        }
        
