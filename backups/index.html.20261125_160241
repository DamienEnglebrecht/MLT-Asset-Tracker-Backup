        function getCustomers() {
            // For Finance/Invoicing view, include ALL customers with towers ON HIRE
            const onHireTowers = fleetData.filter(t => 
                t.customer && 
                (t.status || '').toUpperCase().includes('ON HIRE')
            );
            const fromFleet = [...new Set(onHireTowers.map(t => t.customer))];
            const fromCustom = customData.customers.map(c => c.name);
            return [...new Set([...fromFleet, ...fromCustom])].sort();
        }
        
        function getSitesForCustomer(customer) {
            // Include ALL sites with towers ON HIRE (not just billable ones)
            const fromFleet = fleetData
                .filter(t => t.customer === customer && (t.status || '').toUpperCase().includes('ON HIRE'))
                .map(t => (t.site || '').trim())
                .filter(Boolean);
            const fromCustom = customData.sites
                .filter(s => s.customer === customer)
                .map(s => (s.name || '').trim())
                .filter(Boolean);
            // Combine and deduplicate - use Map to normalize by lowercase key but preserve original case
            const siteMap = new Map();
            [...fromFleet, ...fromCustom].forEach(site => {
                const key = site.toLowerCase();
                if (!siteMap.has(key)) {
                    siteMap.set(key, site);
                }
            });
            return [...siteMap.values()].sort((a, b) => a.localeCompare(b, undefined, {sensitivity: 'base'}));
        }
        
        function getJobsForSite(customer, site) {
            // Get jobs from fleet data (visionJob field) - ALL towers ON HIRE
            const towersAtSite = fleetData.filter(t => 
                t.customer === customer && 
                t.site === site && 
                (t.status || '').toUpperCase().includes('ON HIRE')
            );
            
            const jobsFromFleet = {};
            towersAtSite.forEach(t => {
                const job = t.visionJob || 'UNASSIGNED';
                if (!jobsFromFleet[job]) {
                    jobsFromFleet[job] = {
                        code: job,
                        description: t.jobDescription || '',
                        towerCount: 0,
                        rate: t.rateDaily || t.daily_rate || 0,
                        poNumber: t.poNumber || '',
                        invoicingSchedule: t.invoicingSchedule || ''
                    };
                }
                jobsFromFleet[job].towerCount++;
                // Update poNumber if this tower has one and job doesn't yet
                if (t.poNumber && !jobsFromFleet[job].poNumber) {
                    jobsFromFleet[job].poNumber = t.poNumber;
                }
            });
            
            // Get jobs from custom data
            const jobsFromCustom = customData.jobs
                .filter(j => j.customer === customer && j.site === site)
                .map(j => ({
                    code: j.code,
                    description: j.description,
                    poNumber: j.poNumber,
                    startDate: j.startDate,
                    endDate: j.endDate,
                    rate: j.rate,
                    towerCount: towersAtSite.filter(t => t.visionJob === j.code).length,
                    isCustom: true
                }));
            
            // Merge - custom jobs take precedence for metadata
            const result = [];
            const addedCodes = new Set();
            
            jobsFromCustom.forEach(j => {
                result.push(j);
                addedCodes.add(j.code);
            });
            
            Object.values(jobsFromFleet).forEach(j => {
                if (!addedCodes.has(j.code)) {
                    // Apply PO overrides from Supabase (highest priority)
                    if (poOverrides[j.code]) {
                        const override = poOverrides[j.code];
                        j.poNumber = override.poNumber || j.poNumber;
                        j.startDate = override.poStart || j.startDate;
                        j.endDate = override.poEnd || j.endDate;
                        j.invoicingSchedule = override.invoicingSchedule || j.invoicingSchedule;
                        j.category = override.category || j.category;
                    } else {
                        // Fallback: Try to find PO info from poData
                        const poMatch = poData.find(p => 
                            p.poNumber === j.code || 
                            (p.filename && p.filename.includes(j.code))
                        );
                        if (poMatch) {
                            j.poNumber = poMatch.poNumber;
                            j.startDate = poMatch.startDate;
                            j.endDate = poMatch.endDate;
                        }
                    }
                    result.push(j);
                }
            });
            
            return result.sort((a, b) => (b.towerCount || 0) - (a.towerCount || 0));
        }
        
