        // =============================================
        // PRESENCE TRACKING
        // =============================================
        function initPresence() {
            if (!supabaseClient || !currentUser) return;
            
            // Create presence channel
            presenceChannel = supabaseClient.channel('presence_tracker', {
                config: {
                    presence: {
                        key: currentUser.code
                    }
                }
            });
            
            // Handle presence sync (initial state)
            presenceChannel.on('presence', { event: 'sync' }, () => {
                handlePresenceSync();
            });
            
            // Handle user joining
            presenceChannel.on('presence', { event: 'join' }, ({ key, newPresences }) => {
                handlePresenceJoin(key, newPresences);
            });
            
            // Handle user leaving
            presenceChannel.on('presence', { event: 'leave' }, ({ key, leftPresences }) => {
                handlePresenceLeave(key, leftPresences);
            });
            
            // Subscribe and track
            presenceChannel.subscribe(async (status) => {
                if (status === 'SUBSCRIBED') {
                    presenceConnected = true;
                    updatePresenceConnectionStatus(true);
                    trackPresence('dashboard');
                    
                    // Start heartbeat
                    if (presenceHeartbeatInterval) clearInterval(presenceHeartbeatInterval);
                    presenceHeartbeatInterval = setInterval(() => {
                        if (presenceChannel && presenceConnected) {
                            const currentView = document.querySelector('.view.active')?.id?.replace('view', '').toLowerCase() || 'dashboard';
                            trackPresence(currentView);
                        }
                    }, 30000); // 30 second heartbeat
                } else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
                    presenceConnected = false;
                    updatePresenceConnectionStatus(false);
                    
                    // Attempt reconnection
                    if (presenceReconnectTimeout) clearTimeout(presenceReconnectTimeout);
                    presenceReconnectTimeout = setTimeout(() => {
                        console.log('Attempting presence reconnection...');
                        untrackPresence();
                        initPresence();
                    }, 5000);
                }
            });
            
            // Re-track presence when tab becomes visible again
            // This handles browser tab throttling
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible' && presenceChannel && presenceConnected && currentUser) {
                    const currentView = document.querySelector('.view.active')?.id?.replace('view', '').toLowerCase() || 'dashboard';
                    trackPresence(currentView);
                }
            });
        }
        
        async function trackPresence(view) {
            if (!presenceChannel || !currentUser || !presenceConnected) return;
            
            try {
                await presenceChannel.track({
                    user_code: currentUser.code,
                    user_name: currentUser.name,
                    user_role: currentUser.role,
                    current_view: view,
                    online_at: new Date().toISOString()
                });
            } catch (err) {
                console.error('Failed to track presence:', err);
            }
        }
        
        function updatePresenceView(view) {
            if (presenceChannel && presenceConnected) {
                trackPresence(view);
            }
        }
        
        async function untrackPresence() {
            if (presenceHeartbeatInterval) {
                clearInterval(presenceHeartbeatInterval);
                presenceHeartbeatInterval = null;
            }
            
            if (presenceReconnectTimeout) {
                clearTimeout(presenceReconnectTimeout);
                presenceReconnectTimeout = null;
            }
            
            if (presenceChannel) {
                try {
                    await presenceChannel.untrack();
                    await supabaseClient.removeChannel(presenceChannel);
                } catch (err) {
                    console.error('Failed to untrack presence:', err);
                }
                presenceChannel = null;
            }
            
            presenceConnected = false;
            currentPresenceState = {};
        }
        
        function handlePresenceSync() {
            if (!presenceChannel) return;
            
            const state = presenceChannel.presenceState();
            currentPresenceState = {};
            
            Object.entries(state).forEach(([key, presences]) => {
                if (presences && presences.length > 0) {
                    currentPresenceState[key] = presences[0];
                }
            });
            
            renderPresenceList();
        }
        
        function handlePresenceJoin(key, newPresences) {
            if (newPresences && newPresences.length > 0) {
                currentPresenceState[key] = newPresences[0];
                // Don't show notification here - we use activity_feed for login/logout notifications
                // This just updates the presence list UI
            }
            renderPresenceList();
        }
        
        function handlePresenceLeave(key, leftPresences) {
            // Don't show notification on presence leave - this fires too often due to 
            // browser tab throttling. We only notify on explicit logout (via activity_feed).
            delete currentPresenceState[key];
            renderPresenceList();
        }
        
