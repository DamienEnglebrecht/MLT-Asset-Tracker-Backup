        async function logAudit(action, details = {}) {
            if (!supabaseClient || !currentUser) return;
            try {
                await supabaseClient.from('audit_log').insert({
                    user_name: currentUser.name,
                    user_code: currentUser.code,
                    action: action,
                    details: details
                });
            } catch (e) {
                console.warn('Audit log failed:', e);
            }
        }
        
        // =============================================
        // AUTH
        // =============================================
        function handleLogin() {
            const code = document.getElementById('loginCode').value.trim().toUpperCase();
            const user = validCodes[code];
            
            if (user) {
                currentUser = { ...user, code };
                localStorage.setItem('mlt_tracker_session', JSON.stringify({
                    user: currentUser,
                    expires: Date.now() + (8 * 60 * 60 * 1000)
                }));
                logAudit('LOGIN', { method: 'manual' });
                showApp();
            } else {
                document.getElementById('loginError').style.display = 'block';
                // Log failed attempt
                if (supabaseClient) {
                    supabaseClient.from('audit_log').insert({
                        user_name: 'UNKNOWN',
                        user_code: code,
                        action: 'LOGIN_FAILED',
                        details: { attempted_code: code }
                    });
                }
            }
        }
        
        function checkSession() {
            const session = localStorage.getItem('mlt_tracker_session');
            if (session) {
                const parsed = JSON.parse(session);
                if (parsed.expires > Date.now()) {
                    currentUser = parsed.user;
                    logAudit('SESSION_RESUME', { method: 'cached' });
                    return true;
                }
                localStorage.removeItem('mlt_tracker_session');
            }
            return false;
        }
        
        function handleLogout() {
            // Log logout to activity feed so others get notified
            logActivity('Logged out', null, null, null, null);
            untrackPresence();
            logAudit('LOGOUT', {});
            localStorage.removeItem('mlt_tracker_session');
            currentUser = null;
            document.getElementById('loginScreen').classList.remove('hidden');
            document.getElementById('appContainer').classList.add('hidden');
            document.getElementById('loginCode').value = '';
            document.getElementById('loginError').style.display = 'none';
        }
        
