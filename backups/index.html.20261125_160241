        function submitMovement() {
            const towerId = document.getElementById('moveTowerId').value.trim().toUpperCase();
            const fromSite = document.getElementById('moveFromSite').value;
            const date = document.getElementById('moveDate').value;
            
            // Get all finance fields
            const customer = document.getElementById('moveCustomer').value;
            const visionJob = document.getElementById('moveVisionJob').value.trim();
            const location = document.getElementById('moveLocation').value;
            const poNumber = document.getElementById('movePONumber').value.trim();
            const poStart = document.getElementById('movePOStart').value;
            const poEnd = document.getElementById('movePOEnd').value;
            const poCategory = document.getElementById('movePOCategory').value;
            const hireDuration = document.getElementById('moveHireDuration').value;
            const rateDaily = parseFloat(document.getElementById('moveRateDaily').value) || 0;
            const rateMonthly = parseFloat(document.getElementById('moveRateMonthly').value) || 0;
            const invoicingSchedule = document.getElementById('moveInvoicingSchedule').value;
            const jobDescription = document.getElementById('moveJobDescription').value.trim();
            const notes = document.getElementById('moveNotes').value.trim();
            
            // Validate required fields
            if (!towerId) {
                showToast('Please enter Tower ID', 'error');
                return;
            }
            
            if (fromSite === 'Tower not found' || fromSite === '') {
                showToast('Tower not found in fleet data', 'error');
                return;
            }
            
            if (!date) {
                showToast('Please enter Move Date', 'error');
                return;
            }
            
            if (!customer) {
                showToast('Please select Customer', 'error');
                return;
            }
            
            if (!visionJob) {
                showToast('Please enter Vision Job Code', 'error');
                return;
            }
            
            if (!location) {
                showToast('Please enter Location/Site', 'error');
                return;
            }
            
            if (!poNumber && !isFieldNA('movePONumber')) {
                showToast('Please enter PO Number', 'error');
                return;
            }
            
            if (!poStart && !isFieldNA('movePOStart')) {
                showToast('Please enter PO Start Date', 'error');
                return;
            }
            
            if (!poEnd && !isFieldNA('movePOEnd')) {
                showToast('Please enter PO End Date', 'error');
                return;
            }
            
            if (!poCategory) {
                showToast('Please select PO Category', 'error');
                return;
            }
            
            // Check rates - allow if either has a value OR either has NA checked
            const rateNAChecked = isFieldNA('moveRateDaily') || isFieldNA('moveRateMonthly');
            if (rateDaily === 0 && rateMonthly === 0 && !rateNAChecked) {
                showToast('Please enter either Daily or Monthly rate', 'error');
                return;
            }
            
            if (!invoicingSchedule && !isFieldNA('moveInvoicingSchedule')) {
                showToast('Please select Invoicing Schedule', 'error');
                return;
            }
            
            // Calculate hire duration if not provided
            let calcDuration = hireDuration;
            if (!calcDuration && poStart && poEnd) {
                const start = new Date(poStart);
                const end = new Date(poEnd);
                calcDuration = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
            }
            
            // Record the movement
            const newMovement = {
                id: Date.now(),
                towerId,
                fromSite,
                toSite: visionJob,
                date,
                customer,
                visionJob,
                location,
                poNumber,
                poStart,
                poEnd,
                poCategory,
                hireDuration: calcDuration,
                rateDaily,
                rateMonthly,
                invoicingSchedule,
                jobDescription,
                notes,
                loggedBy: currentUser.name,
                loggedAt: new Date().toISOString()
            };
            movements.unshift(newMovement);
            
            saveMovements();
            saveMovementToSupabase(newMovement);
            addAuditEntry('MOVEMENT', `${towerId}: ${fromSite || 'Unknown'} → ${visionJob} (${customer}, PO: ${poNumber})`);
            
            // Log to activity feed
            logActivity('Moved tower', `${towerId} to ${visionJob}`, towerId, customer, 'Operations');
            
            // Update fleet data in memory with all finance fields
            const tower = fleetData.find(t => 
                (t.id || t.tower_id || '').toUpperCase().replace('MLT', '') === towerId.replace('MLT', '')
            );
            if (tower) {
                tower.visionJob = visionJob;
                tower.site = location;
                tower.location = location;
                tower.customer = customer;
                tower.poNumber = poNumber;
                tower.poStart = poStart;
                tower.poEnd = poEnd;
                tower.category = poCategory;
                tower.hireDuration = calcDuration;
                tower.rateDaily = rateDaily;
                tower.rateMonthly = rateMonthly;
                tower.invoicingSchedule = invoicingSchedule;
                tower.status = 'ON HIRE';
            }
            
            // Sync PO override to Supabase for cross-app sync
            if (supabaseClient) {
                supabaseClient.from('po_overrides').upsert({
                    job_code: visionJob,
                    customer: customer,
                    po_number: poNumber,
                    category: poCategory,
                    location: location,
                    po_start: poStart,
                    po_end: poEnd,
                    invoicing_schedule: invoicingSchedule,
                    updated_by: currentUser.name,
                    updated_at: new Date().toISOString()
                }, { onConflict: 'job_code' }).then(({ error }) => {
                    if (error) console.error('Failed to sync PO override:', error);
                    else console.log('PO override synced for', visionJob);
                });
            }
            
            // Add job to custom data if it doesn't exist
            const existingJob = customData.jobs?.find(j => j.code === visionJob);
            if (!existingJob) {
                if (!customData.jobs) customData.jobs = [];
                customData.jobs.push({
                    code: visionJob,
                    customer: customer,
                    site: location,
                    poNumber: poNumber,
                    startDate: poStart,
                    endDate: poEnd,
                    rate: rateDaily || (rateMonthly / 30),
                    invoicingSchedule: invoicingSchedule,
                    description: jobDescription || 'Tower Hire',
                    createdAt: new Date().toISOString()
                });
                saveCustomData();
            }
            
            hideMovementForm();
            renderMovements();
            renderAuditLog();
            showToast(`Tower ${towerId} moved to ${visionJob} successfully`);
            
            // Clear form
            document.getElementById('moveTowerId').value = '';
            document.getElementById('moveFromSite').value = '';
            document.getElementById('moveToSite').value = '';
            document.getElementById('newDestSection').classList.add('hidden');
            document.getElementById('newDestCode').value = '';
            document.getElementById('newDestCustomer').value = '';
            document.getElementById('newDestSite').value = '';
        }
        
