        async function loadMovementsFromSupabase() {
            if (!supabaseClient) return;
            try {
                const { data, error } = await supabaseClient
                    .from('asset_movements')
                    .select('*')
                    .order('logged_at', { ascending: false });
                
                if (error) {
                    console.error('Failed to load movements from Supabase:', error);
                    return;
                }
                
                if (data && data.length > 0) {
                    // Convert Supabase format to app format
                    movements = data.map(m => ({
                        id: m.id,
                        towerId: m.tower_id,
                        fromSite: m.from_site,
                        toSite: m.to_site,
                        date: m.move_date,
                        customer: m.customer,
                        visionJob: m.vision_job,
                        location: m.location,
                        poNumber: m.po_number,
                        poStart: m.po_start,
                        poEnd: m.po_end,
                        poCategory: m.po_category,
                        hireDuration: m.hire_duration,
                        rateDaily: m.rate_daily,
                        rateMonthly: m.rate_monthly,
                        invoicingSchedule: m.invoicing_schedule,
                        jobDescription: m.job_description,
                        notes: m.notes,
                        loggedBy: m.logged_by,
                        loggedAt: m.logged_at
                    }));
                    console.log(`Loaded ${movements.length} movements from Supabase`);
                    
                    // Apply movements to fleet data to keep it in sync
                    applyMovementsToFleetData();
                }
            } catch (err) {
                console.error('Error loading movements:', err);
            }
        }
        
        async function saveMovementToSupabase(movement) {
            if (!supabaseClient) return;
            try {
                const { error } = await supabaseClient
                    .from('asset_movements')
                    .insert({
                        tower_id: movement.towerId,
                        from_site: movement.fromSite,
                        to_site: movement.toSite,
                        move_date: movement.date,
                        customer: movement.customer,
                        vision_job: movement.visionJob,
                        location: movement.location,
                        po_number: movement.poNumber,
                        po_start: movement.poStart || null,
                        po_end: movement.poEnd || null,
                        hire_duration: movement.hireDuration || null,
                        rate_daily: movement.rateDaily || null,
                        rate_monthly: movement.rateMonthly || null,
                        invoicing_schedule: movement.invoicingSchedule,
                        job_description: movement.jobDescription,
                        notes: movement.notes,
                        logged_by: movement.loggedBy,
                        logged_at: movement.loggedAt
                    });
                
                if (error) {
                    console.error('Failed to save movement to Supabase:', error);
