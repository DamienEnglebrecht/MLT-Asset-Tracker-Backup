            const jobCode = document.getElementById('newPOJobCode').value.trim();
            const poNumber = document.getElementById('newPONumber').value.trim();
            const description = document.getElementById('newPODescription').value.trim();
            const category = document.getElementById('newPOCategory').value;
            const schedule = document.getElementById('newPOSchedule').value;
            const poStart = document.getElementById('newPOStart').value;
            const poEnd = document.getElementById('newPOEnd').value;
            const rateDaily = parseFloat(document.getElementById('newPORateDaily').value) || null;
            const rateMonthly = parseFloat(document.getElementById('newPORateMonthly').value) || null;
            const notes = document.getElementById('newPONotes').value.trim();
            
            // Validation
            if (!customer) { showToast('Please select a customer', 'error'); return; }
            if (!location) { showToast('Please enter a location', 'error'); return; }
            if (!jobCode) { showToast('Please enter a job code', 'error'); return; }
            if (!poNumber) { showToast('Please enter a PO number', 'error'); return; }
            if (!category) { showToast('Please select a category', 'error'); return; }
            if (!schedule) { showToast('Please select an invoicing schedule', 'error'); return; }
            if (!poStart) { showToast('Please enter a start date', 'error'); return; }
            if (!poEnd) { showToast('Please enter an end date', 'error'); return; }
            
            // Check if job code already exists
            const existingPO = fleetData.find(t => t.visionJob === jobCode) || manualPOs.find(p => p.jobCode === jobCode);
            if (existingPO) {
                showToast('A PO with this job code already exists', 'error');
                return;
            }
            
            const newPO = {
                id: 'PO-' + Date.now(),
                customer,
                location,
                jobCode,
                poNumber,
                description,
                category,
                invoicingSchedule: schedule,
                poStart,
                poEnd,
                rateDaily,
                rateMonthly,
                notes,
                towers: [],
                createdBy: currentUser.name,
                createdAt: new Date().toISOString(),
                isManual: true
            };
            
            // Try to save to Supabase
            if (typeof supabaseClient !== 'undefined') {
                try {
                    const { error } = await supabaseClient
                        .from('manual_pos')
                        .insert({
                            id: newPO.id,
                            customer: newPO.customer,
                            location: newPO.location,
                            job_code: newPO.jobCode,
                            po_number: newPO.poNumber,
