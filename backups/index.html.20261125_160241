            try {
                // Save to Supabase po_overrides
                const { error: deleteError } = await supabaseClient
                    .from('po_overrides')
                    .delete()
                    .eq('job_code', selectedJob);
                
                const { error } = await supabaseClient
                    .from('po_overrides')
                    .insert({
                        job_code: selectedJob,
                        customer: selectedCustomer,
                        po_number: newPO,
                        location: selectedSite,
                        updated_by: currentUser?.name || 'Unknown',
                        updated_at: new Date().toISOString()
                    });
                
                if (error) throw error;
                
                // Update local cache
                poOverrides[selectedJob] = {
                    customer: selectedCustomer,
                    poNumber: newPO,
                    location: selectedSite,
                    updatedBy: currentUser?.name || 'Unknown',
                    updatedAt: new Date().toISOString()
                };
                
                // Log activity
                await logActivity('Updated PO Number', `${selectedJob}: ${newPO || '(cleared)'}`, null, selectedCustomer, 'Finance');
                
                // Update UI
                document.getElementById('invoicePO').textContent = newPO || 'Click to add';
                cancelPOEdit();
                showToast('PO Number saved ✓');
                
                // Refresh the invoice view
                renderInvoice();
                
            } catch (err) {
                console.error('Save PO error:', err);
                showToast('Failed to save: ' + (err.message || 'Server error'), 'error');
            } finally {
                saveBtn.textContent = 'Save';
                saveBtn.disabled = false;
            }
        }
        
        async function loadPODocForJob(jobCode) {
            // First check localStorage for actual file data
            if (poDocuments[jobCode] && poDocuments[jobCode].url) {
                currentPODocUrl = poDocuments[jobCode].url;
                updatePODocUI(true, poDocuments[jobCode].fileName);
                return;
            }
            
            // Then try Supabase
            try {
                const { data, error } = await supabaseClient
                    .from('po_documents')
                    .select('*')
                    .eq('job_code', jobCode)
                    .single();
                
                if (data && !error) {
                    // Check if file_url exists in Supabase
                    if (data.file_url) {
                        poDocuments[jobCode] = {
                            url: data.file_url,
                            fileName: data.file_name || data.filename,
                            uploadedAt: data.uploaded_at,
                            uploadedBy: data.uploaded_by,
                            type: data.file_type,
                            isBase64: data.file_url?.startsWith('data:')
                        };
                        localStorage.setItem('mlt_po_documents', JSON.stringify(poDocuments));
                        
                        currentPODocUrl = data.file_url;
                        updatePODocUI(true, data.file_name || data.filename);
                        return;
                    } else {
                        // Supabase has record but no file - show as "needs re-upload"
                        currentPODocUrl = null;
                        updatePODocUI(false, '', data.filename, true);
                        return;
                    }
                }
            } catch (err) {
                console.warn('Could not load PO doc from Supabase:', err);
            }
            
            // No document found
            currentPODocUrl = null;
            updatePODocUI(false);
        }
        
        function updatePODocUI(hasDocument, fileName = '', legacyFilename = '', needsReupload = false) {
            const textEl = document.getElementById('poDocText');
            const viewBtn = document.getElementById('poDocViewBtn');
            const downloadBtn = document.getElementById('poDocDownloadBtn');
            
            if (!textEl) return;
            
            if (needsReupload && legacyFilename) {
                textEl.textContent = `⚠️ ${legacyFilename} (needs re-upload to view)`;
                textEl.classList.add('uploaded');
                textEl.style.color = '#FFA500';
                if (viewBtn) viewBtn.style.display = 'none';
                if (downloadBtn) downloadBtn.style.display = 'none';
            } else if (hasDocument) {
                textEl.textContent = `📄 ${fileName}`;
                textEl.classList.add('uploaded');
                textEl.style.color = '';
                if (viewBtn) viewBtn.style.display = 'inline-flex';
                if (downloadBtn) downloadBtn.style.display = 'inline-flex';
            } else {
                textEl.textContent = 'No PO document uploaded';
                textEl.classList.remove('uploaded');
                textEl.style.color = '';
                if (viewBtn) viewBtn.style.display = 'none';
                if (downloadBtn) downloadBtn.style.display = 'none';
            }
        }
        
        function viewPODocument() {
            if (!currentPODocUrl) {
                showToast('No document to view', 'error');
                return;
            }
            
            // Convert base64 to blob and open - works better across browsers
            if (currentPODocUrl.startsWith('data:')) {
                try {
                    // Extract mime type and base64 data
                    const matches = currentPODocUrl.match(/^data:([^;]+);base64,(.+)$/);
                    if (!matches) {
                        showToast('Invalid document format', 'error');
                        return;
                    }
                    
                    const mimeType = matches[1];
                    const base64Data = matches[2];
                    
                    // Convert base64 to binary
                    const byteCharacters = atob(base64Data);
                    const byteNumbers = new Array(byteCharacters.length);
                    for (let i = 0; i < byteCharacters.length; i++) {
                        byteNumbers[i] = byteCharacters.charCodeAt(i);
                    }
                    const byteArray = new Uint8Array(byteNumbers);
                    
                    // Create blob and URL
                    const blob = new Blob([byteArray], { type: mimeType });
                    const blobUrl = URL.createObjectURL(blob);
                    
                    // Open blob URL - browsers handle this much better
                    window.open(blobUrl, '_blank');
                    
                    // Clean up after a delay
                    setTimeout(() => URL.revokeObjectURL(blobUrl), 60000);
                    
                } catch (err) {
                    console.error('Error opening document:', err);
                    showToast('Could not open document', 'error');
                }
            } else {
                window.open(currentPODocUrl, '_blank');
            }
        }
        
        function downloadPODocument() {
            if (!currentPODocUrl || !selectedJob) {
                showToast('No document to download', 'error');
                return;
            }
            
            const docData = poDocuments[selectedJob];
            if (!docData) return;
            
            const link = document.createElement('a');
            link.href = currentPODocUrl;
            link.download = docData.fileName || `PO_${selectedJob}.pdf`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
        
        function approveInvoice() {
                    if (!selectedCustomer || !selectedSite || !selectedJob) {
                        showToast('Please select a job first', 'error');
                        return;
                    }
            
                    const jobs = getJobsForSite(selectedCustomer, selectedSite);
                    const job = jobs.find(j => j.code === selectedJob);
                    const towers = getTowersForJob(selectedCustomer, selectedSite, selectedJob);
                    const days = 7;
            
                    let total = 0;
                    const lineItems = [];
                    towers.forEach(tower => {
                        const towerRate = parseFloat(tower.rateDaily) || parseFloat(tower.daily_rate) || 0;
                        const lineTotal = towerRate * days;
                        total += lineTotal;
                        lineItems.push({
                            tower_id: tower.id || tower.tower_id,
                            config: tower.config || 'Standard',
                            days: days,
                            daily_rate: towerRate,
                            line_total: lineTotal
                        });
                    });
            
                    // Generate invoice number
                    const invoiceNum = `INV-${selectedJob}-${Date.now().toString(36).toUpperCase()}`;
            
                    // Save to Supabase (async) and localStorage (sync fallback)
                    saveInvoiceToSupabase(invoiceNum, selectedJob, selectedCustomer, selectedSite, total, towers.length, lineItems);
            
                    // Also save to localStorage as fallback
                    const approvedInvoices = JSON.parse(localStorage.getItem('mlt_approved_invoices') || '[]');
                    approvedInvoices.unshift({
                        invoiceNumber: invoiceNum,
                        customer: selectedCustomer,
                        site: selectedSite,
                        jobCode: selectedJob,
                        poNumber: job?.poNumber || selectedJob,
                        description: job?.description || 'Tower Hire',
                        towerCount: towers.length,
                        days: days,
                        total: total,
                        approvedBy: currentUser.name,
                        approvedAt: new Date().toISOString()
                    });
                    localStorage.setItem('mlt_approved_invoices', JSON.stringify(approvedInvoices));
                    
                    // Audit log
                    logAudit('INVOICE_APPROVED', {
                        invoice_number: invoiceNum,
                        customer: selectedCustomer,
                        site: selectedSite,
                        job_code: selectedJob,
                        tower_count: towers.length,
                        total: total
                    });
            
                    // Add audit entry
                    addAuditEntry('INVOICE_APPROVED', `${invoiceNum}: ${selectedCustomer} - ${selectedJob} - $${total.toLocaleString()}`);
                    
                    // Log to activity feed
                    logActivity('Approved invoice', `${invoiceNum} - $${total.toLocaleString()}`, null, selectedCustomer, 'Finance');
            
                    // Show confirmation and offer PDF
                    if (confirm(`Invoice Approved!\n\nInvoice #: ${invoiceNum}\nCustomer: ${selectedCustomer}\nJob: ${selectedJob}\nTotal: $${total.toLocaleString()}\n\nWould you like to generate the PDF now?`)) {
                        previewPDF();
                    }
            
                    showToast(`Invoice ${invoiceNum} approved`);
                }
        
                // Save invoice to Supabase
                async function saveInvoiceToSupabase(invoiceNumber, jobCode, customer, site, total, towerCount, lineItems) {
                    if (!supabaseClient) {
                        console.warn('Supabase not available - invoice saved locally only');
                        return;
                    }
            
                    try {
                        // Insert main invoice record
                        const { data: invoice, error: invoiceError } = await supabaseClient
                            .from('invoices')
                            .insert({
                                invoice_number: invoiceNumber,
                                job_code: jobCode,
                                customer: customer,
                                site: site,
                                total_amount: total,
                                tower_count: towerCount,
                                approved_by: currentUser.name
                            })
                            .select()
                            .single();
                
                        if (invoiceError) {
                            console.error('Invoice save error:', invoiceError);
                            return;
                        }
                
                        // Insert line items
                        const itemsWithInvoiceId = lineItems.map(item => ({
                            ...item,
                            invoice_id: invoice.id
                        }));
                
                        const { error: itemsError } = await supabaseClient
                            .from('invoice_line_items')
                            .insert(itemsWithInvoiceId);
                
                        if (itemsError) {
                            console.error('Line items save error:', itemsError);
                        }
                
                        console.log('Invoice saved to Supabase:', invoiceNumber);
                    } catch (err) {
                        console.error('Supabase error:', err);
                    }
                }
        
                // Load invoice history from Supabase
                async function loadInvoiceHistory() {
                    if (!supabaseClient) {
                        return JSON.parse(localStorage.getItem('mlt_approved_invoices') || '[]');
                    }
            
                    try {
                        const { data, error } = await supabaseClient
                            .from('invoices')
                            .select('*')
                            .order('approved_at', { ascending: false })
                            .limit(100);
                
                        if (error) {
                            console.error('Load history error:', error);
                            return JSON.parse(localStorage.getItem('mlt_approved_invoices') || '[]');
                        }
                
                        return data || [];
                    } catch (err) {
                        console.error('Supabase error:', err);
                        return JSON.parse(localStorage.getItem('mlt_approved_invoices') || '[]');
                    }
                }
        
        // Invoice history data cache
        let invoiceHistoryCache = [];
        
        // Render invoice history
        async function renderHistory() {
            const table = document.getElementById('historyTable');
            const loading = document.getElementById('historyLoading');
            const empty = document.getElementById('historyEmpty');
            
            loading.style.display = 'block';
            table.innerHTML = '';
            empty.style.display = 'none';
            
            try {
                invoiceHistoryCache = await loadInvoiceHistory();
                loading.style.display = 'none';
                
                if (invoiceHistoryCache.length === 0) {
                    empty.style.display = 'block';
                    return;
                }
                
                displayHistoryRows(invoiceHistoryCache);
            } catch (err) {
                console.error('Error loading history:', err);
                loading.textContent = 'Error loading history. Using local data...';
                invoiceHistoryCache = JSON.parse(localStorage.getItem('mlt_approved_invoices') || '[]');
                setTimeout(() => {
                    loading.style.display = 'none';
                    if (invoiceHistoryCache.length === 0) {
                        empty.style.display = 'block';
                    } else {
                        displayHistoryRows(invoiceHistoryCache);
                    }
                }, 1000);
            }
        }
        
        function displayHistoryRows(invoices) {
            const table = document.getElementById('historyTable');
            table.innerHTML = invoices.map(inv => {
                // Handle both Supabase format and localStorage format
                const invoiceNum = inv.invoice_number || inv.invoiceNumber;
                const customer = inv.customer;
                const site = inv.site;
                const jobCode = inv.job_code || inv.jobCode;
                const towerCount = inv.tower_count || inv.towerCount || '-';
                const total = inv.total_amount || inv.total || 0;
                const approvedBy = inv.approved_by || inv.approvedBy;
                const approvedAt = inv.approved_at || inv.approvedAt;
                const dateStr = approvedAt ? new Date(approvedAt).toLocaleDateString('en-AU', { 
                    day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' 
                }) : '-';
                
                return `<tr>
                    <td><code style="background:var(--bg-tertiary);padding:4px 8px;border-radius:4px;font-size:12px;">${invoiceNum}</code></td>
                    <td>${customer}</td>
                    <td>${site}</td>
                    <td>${jobCode}</td>
                    <td style="text-align:center">${towerCount}</td>
                    <td style="font-weight:600;color:var(--success)">$${Number(total).toLocaleString()}</td>
                    <td>${approvedBy}</td>
                    <td style="color:var(--text-secondary);font-size:13px">${dateStr}</td>
                </tr>`;
            }).join('');
        }
        
        function filterHistory() {
            const search = document.getElementById('historySearch').value.toLowerCase().trim();
            if (!search) {
                displayHistoryRows(invoiceHistoryCache);
                return;
            }
            
            const filtered = invoiceHistoryCache.filter(inv => {
                const invoiceNum = (inv.invoice_number || inv.invoiceNumber || '').toLowerCase();
                const customer = (inv.customer || '').toLowerCase();
                const jobCode = (inv.job_code || inv.jobCode || '').toLowerCase();
                const site = (inv.site || '').toLowerCase();
                return invoiceNum.includes(search) || customer.includes(search) || jobCode.includes(search) || site.includes(search);
            });
            
            displayHistoryRows(filtered);
            
            const empty = document.getElementById('historyEmpty');
            if (filtered.length === 0) {
                empty.textContent = 'No invoices match your search.';
                empty.style.display = 'block';
            } else {
                empty.style.display = 'none';
            }
        }
        
        function refreshHistory() {
            document.getElementById('historySearch').value = '';
            renderHistory();
            showToast('History refreshed');
        }
        
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = 'toast active' + (type === 'error' ? ' error' : '');
            setTimeout(() => toast.classList.remove('active'), 3000);
        }
        
        // =============================================
        // INIT
        // =============================================
        document.addEventListener('DOMContentLoaded', () => {
            if (checkSession()) {
                showApp();
            }
        });
    </script>
