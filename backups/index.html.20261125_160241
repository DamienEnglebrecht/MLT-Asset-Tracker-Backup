        // Load PO docs from Supabase on startup
        async function loadPODocsFromSupabase() {
            if (!supabaseClient) return;
            
            try {
                const { data, error } = await supabaseClient
                    .from('po_documents')
                    .select('*');
                    
                if (error) {
                    console.log('po_documents table may not exist yet:', error.message);
                    return;
                }
                
                if (data && data.length > 0) {
                    data.forEach(doc => {
                        poDocuments[doc.job_code] = {
                            url: doc.file_url || doc.dataUrl,
                            fileName: doc.file_name || doc.filename,
                            uploadedAt: doc.uploaded_at,
                            uploadedBy: doc.uploaded_by,
                            fromSupabase: true
                        };
                    });
                    localStorage.setItem('mlt_po_documents', JSON.stringify(poDocuments));
                    console.log(`Loaded ${data.length} PO documents from Supabase`);
                }
            } catch (err) {
