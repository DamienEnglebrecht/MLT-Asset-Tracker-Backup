                    console.log('Movement saved to Supabase:', movement.towerId);
                }
            } catch (err) {
                console.error('Error saving movement:', err);
            }
        }
        
        function applyMovementsToFleetData() {
            // Apply all movements to fleet data to reflect current state
            // Group by tower and apply most recent movement
            const latestByTower = {};
            movements.forEach(m => {
                if (!latestByTower[m.towerId] || new Date(m.loggedAt) > new Date(latestByTower[m.towerId].loggedAt)) {
                    latestByTower[m.towerId] = m;
                }
            });
            
            Object.values(latestByTower).forEach(m => {
                const tower = fleetData.find(t => 
                    (t.id || t.tower_id || '').toUpperCase().replace('MLT', '') === m.towerId.replace('MLT', '')
                );
                if (tower) {
                    tower.visionJob = m.visionJob;
                    tower.site = m.location;
                    tower.location = m.location;
                    tower.customer = m.customer;
                    tower.poNumber = m.poNumber;
                    tower.poStart = m.poStart;
                    tower.poEnd = m.poEnd;
                    tower.category = m.poCategory;
                    tower.hireDuration = m.hireDuration;
                    tower.rateDaily = m.rateDaily;
                    tower.rateMonthly = m.rateMonthly;
                    tower.invoicingSchedule = m.invoicingSchedule;
                    
                    // Only ON HIRE if there's an active rate
                    const hasRate = (m.rateDaily && m.rateDaily > 0) || (m.rateMonthly && m.rateMonthly > 0);
                    tower.status = hasRate ? 'ON HIRE' : 'OFF HIRE';
                }
            });
            console.log('Applied', Object.keys(latestByTower).length, 'tower updates from movements');
        }
        
