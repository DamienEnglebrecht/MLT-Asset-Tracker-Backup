        function renderInvoice() {
            if (!selectedCustomer || !selectedSite || !selectedJob) return;
            
            const jobs = getJobsForSite(selectedCustomer, selectedSite);
            const job = jobs.find(j => j.code === selectedJob);
            if (!job) return;
            
            const towers = getTowersForJob(selectedCustomer, selectedSite, selectedJob);
            const days = 7;
            const totalDays = towers.length * days;
            const total = towers.reduce((sum, t) => {
                const daily = parseFloat(t.rateDaily) || parseFloat(t.daily_rate) || 0;
                return sum + (daily * days);
            }, 0);
            
            document.getElementById('invoiceEmpty').classList.add('hidden');
            document.getElementById('invoiceContent').classList.remove('hidden');
            
            document.getElementById('invoiceTitle').textContent = `${selectedCustomer} - ${selectedSite}`;
            document.getElementById('invoiceSubtitle').textContent = `Job: ${job.code} - ${job.description || 'Tower Hire'}`;
            document.getElementById('invoicePO').textContent = job.poNumber || 'Click to add';
            document.getElementById('poNumberSection').classList.remove('hidden');
            document.getElementById('poNumberEdit').classList.add('hidden');
            
            document.getElementById('statTowers').textContent = towers.length;
            document.getElementById('statPeriod').textContent = job.poNumber || '-';
            document.getElementById('statRateType').textContent = job.invoicingSchedule || '-';
            document.getElementById('statTotal').textContent = `$${total.toLocaleString('en-AU', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            
            let html = '';
            towers.forEach(tower => {
                const towerId = tower.id || tower.tower_id;
                const model = tower.model || '-';
                const config = tower.config || '-';
                const location = tower.location || tower.site || '-';
                const poStart = tower.poStart || '-';
                const poEnd = tower.poEnd || '-';
                const duration = tower.hireDuration || '-';
                const dailyRate = parseFloat(tower.rateDaily) || 0;
                const monthlyRate = parseFloat(tower.rateMonthly) || 0;
                const lineTotal = dailyRate > 0 ? dailyRate * days : (monthlyRate / 4.33);
                
                html += `
                    <tr>
                        <td class="tower-id">${towerId}</td>
                        <td>${model}</td>
                        <td><span class="config-badge">${config}</span></td>
                        <td>${location}</td>
                        <td>${poStart}</td>
                        <td>${poEnd}</td>
                        <td>${duration}</td>
                        <td class="money">${dailyRate > 0 ? '$' + dailyRate.toFixed(2) : '-'}</td>
                        <td class="money">${monthlyRate > 0 ? '$' + monthlyRate.toFixed(2) : '-'}</td>
                        <td class="money">$${lineTotal.toFixed(2)}</td>
                    </tr>
                `;
            });
            
            html += `
                <tr class="total-row">
                    <td colspan="9">Total (${towers.length} towers)</td>
                    <td class="money">$${total.toLocaleString('en-AU', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                </tr>
            `;
            
            document.getElementById('invoiceTable').innerHTML = html;
            
            // Load PO document for this job
            loadPODocForJob(selectedJob);
        }
        
