        // Check if a tower is internal/non-billable
        function isInternalTower(tower) {
            const daily = parseFloat(tower.rateDaily || tower.daily_rate) || 0;
            const monthly = parseFloat(tower.rateMonthly || tower.monthly_rate) || 0;
            const status = (tower.status || '').toUpperCase();
            return (daily === 0 && monthly === 0) && !status.includes('SOLD') && !status.includes('WRITTEN');
        }
        
        // Get all internal towers
        function getInternalTowers() {
            return fleetData.filter(isInternalTower);
        }
        
        // Get customers/owners for internal fleet
        function getInternalCustomers() {
            const internalTowers = getInternalTowers();
            const customers = new Map();
            
            internalTowers.forEach(t => {
                const customer = t.customer || 'Mickala';
                if (!customers.has(customer)) {
                    customers.set(customer, { name: customer, count: 0 });
                }
                customers.get(customer).count++;
            });
            
            return Array.from(customers.values()).sort((a, b) => b.count - a.count);
        }
        
        // Get sites for a customer's internal towers
        function getInternalSitesForCustomer(customer) {
            const internalTowers = getInternalTowers().filter(t => (t.customer || 'Mickala') === customer);
            const sites = new Map();
            
            internalTowers.forEach(t => {
                const site = t.site || 'Yard / Unassigned';
                if (!sites.has(site)) {
                    sites.set(site, { name: site, count: 0 });
                }
                sites.get(site).count++;
            });
            
            return Array.from(sites.values()).sort((a, b) => b.count - a.count);
        }
        
        // Get jobs/POs for a site's internal towers
        function getInternalJobsForSite(customer, site) {
            const internalTowers = getInternalTowers().filter(t => 
                (t.customer || 'Mickala') === customer && 
                (t.site || 'Yard / Unassigned') === site
            );
            const jobs = new Map();
            
            internalTowers.forEach(t => {
                const job = t.visionJob || 'UNASSIGNED';
                if (!jobs.has(job)) {
                    jobs.set(job, { code: job, count: 0, description: t.jobDescription || '' });
                }
                jobs.get(job).count++;
            });
            
            return Array.from(jobs.values()).sort((a, b) => b.count - a.count);
        }
        
        // Get towers for a specific job in internal fleet
        function getInternalTowersForJob(customer, site, jobCode) {
            return getInternalTowers().filter(t => 
                (t.customer || 'Mickala') === customer && 
                (t.site || 'Yard / Unassigned') === site &&
                (t.visionJob || 'UNASSIGNED') === jobCode
            );
        }
        
